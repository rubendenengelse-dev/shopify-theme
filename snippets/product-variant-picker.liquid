{% comment %}
  Renders product variant-picker

  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} Id of the product form to which the variant picker is associated.
  Usage:
  {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
{% endcomment %}
{%- unless product.has_only_default_variant -%}
  <style>
    #variant-selects-{{ section.id }} .product-form__option-label--soft {
      color: rgba(0, 0, 0, 0.68);
      font-size: 1.3rem;
    }

    #variant-selects-{{ section.id }} .product-form__size-pill-options {
      display: inline-flex;
      align-items: stretch;
      width: 100%;
      max-width: 100%;
      overflow: hidden;
      border: 0.1rem solid rgba(0, 0, 0, 0.16);
      border-radius: 0;
      background: #fff;
    }

    #variant-selects-{{ section.id }} .product-form__input--size-pill {
      max-width: 44rem;
      width: 100%;
    }

    #variant-selects-{{ section.id }} .product-form__input--size-pill input[type='radio'] + label {
      display: inline-flex;
      flex: 1 1 0;
      align-items: center;
      justify-content: center;
      min-width: 4.6rem;
      margin: 0;
      padding: 1.15rem 1.45rem;
      border: 0;
      border-radius: 0;
      background: transparent;
      color: #000;
      font-size: 1.3rem;
      letter-spacing: 0;
      line-height: 1;
    }

    #variant-selects-{{ section.id }} .product-form__input--size-pill input[type='radio'] + label::before {
      content: none;
    }

    #variant-selects-{{ section.id }} .product-form__input--size-pill input[type='radio'] + label:hover {
      background: #000;
      border-color: transparent;
      color: #fff;
      transition: background-color 180ms ease, color 180ms ease;
    }

    #variant-selects-{{ section.id }} .product-form__input--size-pill input[type='radio']:checked + label {
      background: #000;
      color: #fff;
    }

    #variant-selects-{{ section.id }} .product-form__input--size-pill input[type='radio']:focus-visible + label {
      box-shadow: inset 0 0 0 0.2rem rgba(255, 255, 255, 0.7), 0 0 0 0.2rem rgba(0, 0, 0, 0.25);
    }

    #variant-selects-{{ section.id }} .product-form__input--color-option {
      align-items: flex-start;
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
    }

    #variant-selects-{{ section.id }} .product-form__input--color-option .form__label {
      flex: 0 0 100%;
      margin-bottom: 0;
      width: 100%;
    }

    #variant-selects-{{ section.id }} .product-form__color-value {
      display: inline-block;
      transform: translateX(0);
    }

    #variant-selects-{{ section.id }} .product-form__color-value[data-color-value='wit'],
    #variant-selects-{{ section.id }} .product-form__color-value[data-color-value='white'] {
      transform: translateX(6px);
    }

    #variant-selects-{{ section.id }} .product-form__input--color-option .swatch-input__input + .swatch-input__label,
    #variant-selects-{{ section.id }} .product-form__input--color-option input[type='radio'] + .product-form__color-swatch-label {
      --swatch-input--border-radius: 50%;
      --swatch-input--size: 3.2rem;
      align-items: center;
      background: rgba(0, 0, 0, 0.12);
      border: 0;
      border-radius: 50%;
      box-shadow: 0 0.35rem 1rem rgba(0, 0, 0, 0.14), inset 0 0 0 0.1rem rgba(0, 0, 0, 0.12);
      box-sizing: border-box;
      cursor: pointer;
      display: inline-flex;
      height: var(--swatch-input--size);
      justify-content: center;
      margin: 0;
      outline: 0;
      padding: 0.28rem;
      position: relative;
      transition: box-shadow 180ms ease, transform 180ms ease;
      width: var(--swatch-input--size);
    }

    #variant-selects-{{ section.id }} .product-form__input--color-option .swatch,
    #variant-selects-{{ section.id }} .product-form__color-swatch {
      border-radius: 50%;
      display: block;
      height: 100%;
      width: 100%;
    }

    #variant-selects-{{ section.id }} .product-form__color-swatch {
      background: var(--product-color-swatch, #d8d8d8);
      border: 0.1rem solid rgba(0, 0, 0, 0.2);
      box-shadow: inset 0 0 0 0.1rem rgba(0, 0, 0, 0.08);
    }

    #variant-selects-{{ section.id }} .product-form__color-swatch-label[style*='#ffffff'] .product-form__color-swatch,
    #variant-selects-{{ section.id }} .swatch-input__label .swatch[style*='#ffffff'],
    #variant-selects-{{ section.id }} .swatch-input__label .swatch[style*='255, 255, 255'] {
      border-color: rgba(0, 0, 0, 0.32);
      box-shadow: inset 0 0 0 0.1rem rgba(0, 0, 0, 0.12);
    }

    #variant-selects-{{ section.id }} .product-form__input--color-option .swatch-input__input:checked + .swatch-input__label,
    #variant-selects-{{ section.id }} .product-form__input--color-option input[type='radio']:checked + .product-form__color-swatch-label {
      box-shadow: 0 0 0 0.14rem #000, 0 0.45rem 1.15rem rgba(0, 0, 0, 0.18), inset 0 0 0 0.1rem rgba(0, 0, 0, 0.16);
    }

    #variant-selects-{{ section.id }} .product-form__input--color-option .swatch-input__input + .swatch-input__label:hover,
    #variant-selects-{{ section.id }} .product-form__input--color-option input[type='radio'] + .product-form__color-swatch-label:hover {
      box-shadow: 0 0 0 0.14rem rgba(0, 0, 0, 0.42), 0 0.45rem 1.15rem rgba(0, 0, 0, 0.18), inset 0 0 0 0.1rem rgba(0, 0, 0, 0.16);
    }

    #variant-selects-{{ section.id }} .product-form__input--color-option input[type='radio'] + .product-form__color-swatch-label::before {
      content: none;
    }

    @media screen and (max-width: 749px) {
      #variant-selects-{{ section.id }} .product-form__input {
        width: min(100% - 3.2rem, 40.8rem) !important;
        margin-left: auto !important;
        margin-right: auto !important;
      }

      #variant-selects-{{ section.id }} .product-form__input--size-pill {
        max-width: min(100% - 3.2rem, 40.8rem);
      }

      #variant-selects-{{ section.id }} .product-form__input--size-pill input[type='radio'] + label {
        -webkit-tap-highlight-color: transparent;
      }

      #variant-selects-{{ section.id }} .product-form__input--size-pill input[type='radio']:focus + label,
      #variant-selects-{{ section.id }} .product-form__input--size-pill input[type='radio']:focus-visible + label,
      #variant-selects-{{ section.id }} .product-form__input--size-pill input[type='radio'].focused + label {
        outline: 0 !important;
        box-shadow: none !important;
      }
    }
  </style>
  <variant-selects
    id="variant-selects-{{ section.id }}"
    data-section="{{ section.id }}"
    {{ block.shopify_attributes }}
  >
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign swatch_count = option.values | map: 'swatch' | compact | size
        assign picker_type = block.settings.picker_type
        assign option_label = option.name
        assign normalized_option_name = option.name | downcase | strip
        assign is_size_option = false
        assign is_color_option = false

        assign option_label_class = ''
        assign option_fieldset_class = ''

        if normalized_option_name == 'grootte' or normalized_option_name == 'maat' or normalized_option_name == 'maten' or normalized_option_name == 'size' or normalized_option_name == 'sizes'
          assign is_size_option = true
        endif

        if normalized_option_name == 'kleur' or normalized_option_name == 'color' or normalized_option_name == 'colour'
          assign is_color_option = true
        endif

        if is_size_option
          assign option_label = 'Selecteer een maat'
          assign option_label_class = ' product-form__option-label--soft'
          assign option_fieldset_class = ' product-form__input--size-pill'
        elsif is_color_option
          assign option_fieldset_class = ' product-form__input--color-option'
        endif

        if swatch_count > 0 and block.settings.swatch_shape != 'none'
          if block.settings.picker_type == 'dropdown'
            assign picker_type = 'swatch_dropdown'
          else
            assign picker_type = 'swatch'
          endif
        elsif is_color_option and picker_type == 'button'
          assign picker_type = 'color_button'
        endif
      -%}
      {%- if picker_type == 'swatch' -%}
        <fieldset class="js product-form__input product-form__input--swatch{{ option_fieldset_class }}">
          <legend class="form__label{{ option_label_class }}">
            {%- if is_color_option -%}
              <span
                class="product-form__color-value"
                data-selected-value
                data-color-value="{{ option.selected_value | downcase | strip | escape }}"
              >
                {{- option.selected_value -}}
              </span>
            {%- else -%}
              {{ option_label }}:
              <span data-selected-value>
                {{- option.selected_value -}}
              </span>
            {%- endif -%}
          </legend>
          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>
      {%- elsif picker_type == 'button' or picker_type == 'color_button' -%}
        <fieldset class="js product-form__input product-form__input--pill{{ option_fieldset_class }}">
          <legend class="form__label{{ option_label_class }}">
            {%- if is_color_option -%}
              <span
                class="product-form__color-value"
                data-selected-value
                data-color-value="{{ option.selected_value | downcase | strip | escape }}"
              >
                {{- option.selected_value -}}
              </span>
            {%- else -%}
              {{ option_label }}
            {%- endif -%}
          </legend>
          {%- if is_size_option -%}
            <div class="product-form__size-pill-options">
              {% render 'product-variant-options',
                product: product,
                option: option,
                block: block,
                picker_type: picker_type
              %}
            </div>
          {%- else -%}
            {% render 'product-variant-options',
              product: product,
              option: option,
              block: block,
              picker_type: picker_type
            %}
          {%- endif -%}
        </fieldset>
      {%- else -%}
        <div class="product-form__input product-form__input--dropdown">
          <label class="form__label{{ option_label_class }}" for="Option-{{ section.id }}-{{ forloop.index0 }}">
            {{ option_label }}
          </label>
          <div class="select">
            {%- if picker_type == 'swatch_dropdown' -%}
              <span
                data-selected-value
                class="dropdown-swatch"
              >
                {% render 'swatch', swatch: option.selected_value.swatch, shape: block.settings.swatch_shape %}
              </span>
            {%- endif -%}
            <select
              id="Option-{{ section.id }}-{{ forloop.index0 }}"
              class="select__select"
              name="options[{{ option.name | escape }}]"
              form="{{ product_form_id }}"
            >
              {% render 'product-variant-options',
                product: product,
                option: option,
                block: block,
                picker_type: picker_type
              %}
            </select>
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    <script type="application/json" data-selected-variant>
      {{ product.selected_or_first_available_variant | json }}
    </script>

    <script>
      (() => {
        const picker = document.getElementById('variant-selects-{{ section.id }}');
        if (!picker) return;

        const normalizeColorValue = (value) => value.trim().toLowerCase();
        const colorFieldsets = picker.querySelectorAll('.product-form__input--color-option');

        colorFieldsets.forEach((fieldset) => {
          const valueLabel = fieldset.querySelector('[data-selected-value]');
          if (!valueLabel) return;

          const setValueLabel = (value) => {
            valueLabel.textContent = value;
            valueLabel.dataset.colorValue = normalizeColorValue(value);
          };

          const setCheckedValue = () => {
            const checkedInput = fieldset.querySelector('input[type="radio"]:checked');
            if (checkedInput) setValueLabel(checkedInput.value);
          };

          fieldset.querySelectorAll('input[type="radio"] + label').forEach((label) => {
            const input = label.previousElementSibling;
            if (!input || input.type !== 'radio') return;

            label.addEventListener('mouseenter', () => setValueLabel(input.value));
            label.addEventListener('mouseleave', setCheckedValue);
            input.addEventListener('change', setCheckedValue);
          });

          setCheckedValue();
        });
      })();
    </script>
  </variant-selects>
{%- endunless -%}
