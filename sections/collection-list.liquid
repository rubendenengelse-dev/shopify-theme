{{ 'section-collection-list.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- assign render_only_collection_handle = section.settings.render_only_collection_handle | strip -%}
{%- assign should_render_collection_list = true -%}
{%- if render_only_collection_handle != blank -%}
  {%- if request.page_type != 'collection' or collection.handle != render_only_collection_handle -%}
    {%- assign should_render_collection_list = false -%}
  {%- endif -%}
{%- endif -%}
{%- assign is_collection_tshirts_vrouwen = false -%}
{%- if request.page_type == 'collection' and collection.handle == 't-shirts-vrouwen' and render_only_collection_handle == 't-shirts-vrouwen' -%}
  {%- assign is_collection_tshirts_vrouwen = true -%}
{%- endif -%}
{%- assign is_tshirts_template = false -%}
{%- if template.suffix == 't-shirts' or template.suffix == 't-shirts-man' or template.suffix == 't-shirts-vrouw' or template.suffix == 'dames-t-shirts' or template.suffix == 't-shirts-dames' or template.suffix == 't-shirt-mannen' -%}
  {%- assign is_tshirts_template = true -%}
{%- endif -%}
{%- assign is_hoodies_template = false -%}
{%- if template.suffix == 'hoodies' or template.suffix == 'hoodies-man' or template.suffix == 'hoodies-vrouw' or template.suffix == 'vrouwen-hoodie' or template.suffix == 'hoodies-vrouwen' -%}
  {%- assign is_hoodies_template = true -%}
{%- endif -%}
{%- assign is_oversize_tshirts_template = false -%}
{%- if template.suffix == 'oversize-t-shirt-s' -%}
  {%- assign is_oversize_tshirts_template = true -%}
{%- endif -%}
{%- assign is_tshirts_like_collection_list = false -%}
{%- if is_tshirts_template or is_oversize_tshirts_template or is_hoodies_template or is_collection_tshirts_vrouwen -%}
  {%- assign is_tshirts_like_collection_list = true -%}
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  {%- if request.page_type == 'index' -%}
    .section-{{ section.id }}-padding.collection-list-wrapper {
      padding-top: calc({{ section.settings.padding_top | times: 0.75 | round: 0 }}px + 1.4rem);
    }

    .section-{{ section.id }}-padding .collection-list-title,
    .section-{{ section.id }}-padding .collection-list-title * {
      font-family: var(--font-body-family) !important;
      font-style: var(--font-body-style) !important;
      font-weight: 700 !important;
      letter-spacing: 0 !important;
      line-height: 1.05 !important;
    }

    .section-{{ section.id }}-padding .collection-list .card__heading,
    .section-{{ section.id }}-padding .collection-list .card__heading a {
      font-family: var(--font-body-family) !important;
      font-style: var(--font-body-style) !important;
      font-weight: 600 !important;
      letter-spacing: 0 !important;
    }

    .section-{{ section.id }}-padding .slider-mobile-gutter {
      position: relative;
    }

    .section-{{ section.id }}-padding .collection-list {
      row-gap: 0 !important;
    }

    .section-{{ section.id }}-padding .collection-list .icon-wrap {
      display: none !important;
    }
  {%- endif -%}

  .section-{{ section.id }}-padding:not(.collection-list-homepage-slider) .collection-list .icon-wrap {
    display: none !important;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    {%- if request.page_type == 'index' -%}
      .section-{{ section.id }}-padding.collection-list-wrapper {
        padding-top: calc({{ section.settings.padding_top }}px + 1.8rem);
      }

      .section-{{ section.id }}-padding.collection-list-homepage-slider {
        max-width: 100%;
        padding-left: 4.5rem;
        padding-right: 5rem;
        margin-left: 0;
        margin-right: auto;
      }

      .section-{{ section.id }}-padding.collection-list-homepage-slider .title-wrapper-with-link,
      .section-{{ section.id }}-padding.collection-list-homepage-slider .slider-mobile-gutter {
        max-width: 100% !important;
        margin-left: 0;
        margin-right: 0;
        padding-left: 0 !important;
        padding-right: 0 !important;
      }

      .section-{{ section.id }}-padding.collection-list-homepage-slider .title-wrapper-with-link {
        justify-content: flex-start !important;
      }

      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list-title {
        font-size: 2.8rem !important;
        line-height: 1.05 !important;
        margin-right: 0 !important;
      }

      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list {
        justify-content: flex-start !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
        scroll-padding-left: 0 !important;
      }

      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list.slider--desktop::after {
        padding-left: 0 !important;
      }

      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list__item {
        scroll-margin-left: 0 !important;
      }

      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list__item.slider__slide {
        max-width: calc(25% - var(--grid-desktop-horizontal-spacing) * 3 / 4) !important;
        width: calc(25% - var(--grid-desktop-horizontal-spacing) * 3 / 4) !important;
      }

      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list-desktop-controls {
        display: flex !important;
        gap: 1rem;
        position: absolute;
        right: 0;
        top: 0;
        transform: translate(-0.2rem, -5.1rem);
        z-index: 2;
      }

      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list-desktop-controls .slider-button {
        border: 0;
        border-radius: 50%;
        box-shadow: none;
        height: 3.4rem;
        width: 3.4rem;
      }

      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list-desktop-controls .slider-button .svg-wrapper {
        align-items: center;
        display: inline-flex;
        height: 1.1rem;
        justify-content: center;
        width: 1.1rem;
      }

      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list-desktop-controls .slider-button .svg-wrapper svg {
        height: 1.1rem !important;
        width: 1.1rem !important;
        opacity: 1 !important;
      }

      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list-desktop-controls .slider-button .svg-wrapper svg.icon {
        fill: currentColor !important;
        stroke: none !important;
      }

      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list-desktop-controls .slider-counter {
        display: none;
      }

      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list-desktop-controls .slider-button--prev {
        background: #d9d9d9;
        color: #000;
        transform: translateX(-1px);
      }

      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list-desktop-controls .slider-button--prev .svg-wrapper {
        color: #000;
        opacity: 1;
        transform: translateX(-1px);
      }

      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list-desktop-controls .slider-button--prev .svg-wrapper svg.icon {
        transform: rotate(90deg);
        transform-origin: center;
      }

      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list-desktop-controls .slider-button--prev:not([disabled]) {
        background: #000 !important;
        color: #fff !important;
      }

      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list-desktop-controls .slider-button--prev:not([disabled]) .svg-wrapper,
      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list-desktop-controls .slider-button--prev:not([disabled]) .svg-wrapper svg,
      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list-desktop-controls .slider-button--prev:not([disabled]) .svg-wrapper svg * {
        color: #fff !important;
        fill: #fff !important;
        stroke: #fff !important;
      }

      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list-desktop-controls .slider-button--next {
        background: #000 !important;
        color: #fff !important;
      }

      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list-desktop-controls .slider-button--next .svg-wrapper {
        color: #fff;
        opacity: 1;
        transform: translateX(1px);
      }

      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list-desktop-controls .slider-button--next .svg-wrapper svg.icon {
        transform: rotate(-90deg);
        transform-origin: center;
      }

      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list-desktop-controls .slider-button--next:not([disabled]) .svg-wrapper svg.icon path {
        transform: scale(1.22);
        transform-box: fill-box;
        transform-origin: center;
      }

      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list-desktop-controls .slider-button--next[disabled] {
        background: #d9d9d9 !important;
        color: #000 !important;
      }

      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list-desktop-controls .slider-button--next[disabled] .svg-wrapper,
      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list-desktop-controls .slider-button--next[disabled] .svg-wrapper svg,
      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list-desktop-controls .slider-button--next[disabled] .svg-wrapper svg * {
        color: #000 !important;
        fill: #000 !important;
        stroke: #000 !important;
        opacity: 1 !important;
      }

      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list-desktop-controls .slider-button--prev[disabled] {
        background: #d9d9d9 !important;
        color: #000 !important;
      }

      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list-desktop-controls .slider-button--prev[disabled] .svg-wrapper,
      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list-desktop-controls .slider-button--prev[disabled] .svg-wrapper svg,
      .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list-desktop-controls .slider-button--prev[disabled] .svg-wrapper svg * {
        color: #000 !important;
        fill: #000 !important;
        stroke: #000 !important;
        opacity: 1 !important;
      }
    {%- endif -%}

    {% if is_tshirts_like_collection_list %}
      .section-{{ section.id }}-padding.collection-list-wrapper {
        max-width: 100%;
        padding-left: 4.5rem;
        padding-right: 5rem;
        margin-left: 0;
        margin-right: auto;
      }

      .section-{{ section.id }}-padding .slider-mobile-gutter {
        margin-left: 0 !important;
        margin-right: auto !important;
        max-width: 100%;
        position: relative;
      }

      .section-{{ section.id }}-padding .collection-list {
        justify-content: flex-start !important;
        margin-left: 0 !important;
        margin-right: auto !important;
        padding-left: 0 !important;
        scroll-padding-left: 0 !important;
      }

      .section-{{ section.id }}-padding .collection-list__item {
        scroll-margin-left: 0 !important;
      }

      .section-{{ section.id }}-padding .collection-list-desktop-controls {
        display: flex !important;
        gap: 1rem;
        position: absolute;
        right: 3.5rem;
        top: 0;
        transform: translateY(-5.1rem);
        z-index: 2;
      }

      .section-{{ section.id }}-padding .collection-list-desktop-controls .slider-button {
        border: 0;
        border-radius: 50%;
        box-shadow: none;
        height: 3.4rem;
        width: 3.4rem;
      }

      .section-{{ section.id }}-padding .collection-list-desktop-controls .slider-button .svg-wrapper {
        align-items: center;
        display: inline-flex;
        height: 1.1rem;
        justify-content: center;
        width: 1.1rem;
      }

      .section-{{ section.id }}-padding .collection-list-desktop-controls .slider-button .svg-wrapper svg {
        height: 1.1rem !important;
        width: 1.1rem !important;
      }

      .section-{{ section.id }}-padding .collection-list-desktop-controls .slider-counter {
        display: none;
      }

      .section-{{ section.id }}-padding .collection-list-desktop-controls .slider-button--prev {
        background: #d9d9d9;
        color: #000;
        transform: translateX(-1px);
      }

      .section-{{ section.id }}-padding .collection-list-desktop-controls .slider-button--prev .svg-wrapper {
        color: #000;
        opacity: 1;
        transform: translateX(-2px);
      }

      .section-{{ section.id }}-padding .collection-list-desktop-controls .slider-button--prev:not([disabled]) {
        background: #000;
        color: #fff;
      }

      .section-{{ section.id }}-padding .collection-list-desktop-controls .slider-button--prev:not([disabled]) .svg-wrapper,
      .section-{{ section.id }}-padding .collection-list-desktop-controls .slider-button--prev:not([disabled]) .svg-wrapper svg,
      .section-{{ section.id }}-padding .collection-list-desktop-controls .slider-button--prev:not([disabled]) .svg-wrapper svg * {
        color: #fff !important;
        fill: #fff !important;
        stroke: #fff !important;
      }

      .section-{{ section.id }}-padding .collection-list-desktop-controls .slider-button--next {
        background: #000;
        color: #fff;
      }

      .section-{{ section.id }}-padding .collection-list-desktop-controls .slider-button--next .svg-wrapper {
        color: #fff;
        opacity: 1;
        transform: translateX(2px);
      }

      .section-{{ section.id }}-padding .collection-list-desktop-controls .slider-button--next[disabled] {
        background: #d9d9d9;
        color: #000;
      }

      .section-{{ section.id }}-padding .collection-list-desktop-controls .slider-button--next[disabled] .svg-wrapper,
      .section-{{ section.id }}-padding .collection-list-desktop-controls .slider-button--next[disabled] .svg-wrapper svg,
      .section-{{ section.id }}-padding .collection-list-desktop-controls .slider-button--next[disabled] .svg-wrapper svg * {
        color: #000 !important;
        fill: #000 !important;
        stroke: #000 !important;
      }
    {% endif %}
  }

  @media screen and (max-width: 989px) {
    .section-{{ section.id }}-padding .collection-list-desktop-controls {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }}-padding.collection-list-homepage-slider {
      padding-left: 0;
      padding-right: 0;
    }

    .section-{{ section.id }}-padding.collection-list-homepage-slider .title-wrapper-with-link {
      padding-left: 1.5rem !important;
      padding-right: 1.5rem !important;
    }

    .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list-title {
      font-size: 1.8rem !important;
      line-height: 1.15 !important;
      padding-top: 1.2rem !important;
    }

    .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list {
      padding-left: 1.5rem !important;
      padding-right: 1.5rem !important;
    }

    .section-{{ section.id }}-padding.collection-list-homepage-slider .collection-list__item.slider__slide {
      width: calc(50% - var(--grid-mobile-horizontal-spacing) / 2) !important;
      max-width: calc(50% - var(--grid-mobile-horizontal-spacing) / 2) !important;
    }

    .section-{{ section.id }}-padding .slider-buttons {
      display: none !important;
    }
  }
{%- endstyle -%}

{%- liquid
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and section.blocks.size > columns_mobile_int
    assign show_mobile_slider = true
  endif
  assign is_homepage_collection_list = false
  if request.page_type == 'index'
    assign is_homepage_collection_list = true
  endif
  assign collection_columns_desktop = section.settings.columns_desktop
  if is_homepage_collection_list
    assign collection_columns_desktop = 4
  endif
  assign show_desktop_collection_slider = false
  if is_homepage_collection_list and section.blocks.size > collection_columns_desktop
    assign show_desktop_collection_slider = true
  elsif is_tshirts_like_collection_list
    if section.blocks.size > 1
      assign show_desktop_collection_slider = true
    endif
  endif
-%}

{% if should_render_collection_list %}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="collection-list-wrapper page-width isolate{% if show_mobile_slider %} page-width-desktop{% endif %}{% if section.settings.title == blank %} no-heading{% endif %}{% if section.settings.show_view_all == false or section.blocks.size > collections.size %} no-mobile-link{% endif %} section-{{ section.id }}-padding{% if is_homepage_collection_list %} collection-list-homepage-slider{% endif %}">
    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper-with-link{% if show_mobile_slider %} title-wrapper--self-padded-tablet-down{% else %} title-wrapper--self-padded-mobile{% endif %} title-wrapper--no-top-margin">
        <h2
          id="SectionHeading-{{ section.id }}"
          class="collection-list-title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        >
          {{ section.settings.title }}
        </h2>

        {%- if section.settings.show_view_all and show_mobile_slider -%}
          <a
            href="{{ routes.collections_url }}"
            id="ViewAll-{{ section.id }}"
            class="link underlined-link large-up-hide{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            aria-labelledby="ViewAll-{{ section.id }} SectionHeading-{{ section.id }}"
          >
            {{- 'sections.collection_list.view_all' | t -}}
          </a>
        {%- endif -%}
      </div>
    {%- endunless -%}

    <slider-component class="slider-mobile-gutter{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"{% if is_homepage_collection_list %} data-wog-laptop-soft-slide{% endif %}>
      <ul
        class="collection-list contains-card contains-card--collection{% if settings.card_style == 'standard' %} contains-card--standard{% endif %} grid grid--{{ collection_columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down{% if show_desktop_collection_slider %} slider slider--desktop{% elsif section.settings.swipe_on_mobile %} slider slider--tablet grid--peek{% endif %} collection-list--{{ section.blocks.size }}-items"
        id="Slider-{{ section.id }}"
        role="list"
        aria-label="{{ 'general.slider.name' | t }}"
      >
        {%- liquid
          assign columns = section.blocks.size
          if columns > 3
            assign columns = 3
          endif
        -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign wog_collection_card_url = blank
            if is_homepage_collection_list
              case block.settings.collection
                when 'mens'
                  assign wog_collection_card_url = '/pages/t-shirts'
                when 'hoodies'
                  assign wog_collection_card_url = '/pages/hoodies'
                when '07-t-shirtss'
                  assign wog_collection_card_url = '/pages/dames-t-shirts'
                when '07-hoodies'
                  assign wog_collection_card_url = '/pages/vrouwen-hoodie'
                when 'oversize-tshirts'
                  assign wog_collection_card_url = '/pages/oversize-t-shirt-s'
              endcase
            endif
          -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="collection-list__item grid__item{% if show_mobile_slider or show_desktop_collection_slider %} slider__slide{% endif %}{% if block.settings.collection.featured_image == nil %} collection-list__item--no-media{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
            {%- assign placeholder_image = 'collection-apparel-' | append: placeholder_image_index -%}
            {% render 'card-collection',
              card_collection: block.settings.collection,
              card_url: wog_collection_card_url,
              media_aspect_ratio: section.settings.image_ratio,
              columns: columns,
              placeholder_image: placeholder_image
            %}
          </li>
        {%- endfor -%}
      </ul>
      {%- if show_mobile_slider or show_desktop_collection_slider -%}
        <div class="slider-buttons{% if show_desktop_collection_slider %} collection-list-desktop-controls{% endif %}">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
            {% if is_homepage_collection_list %}disabled="disabled"{% endif %}
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>

    {%- if is_homepage_collection_list -%}
      <script>
        (() => {
          const slider = document.getElementById('Slider-{{ section.id }}');
          if (!slider) return;

          const sliderComponent = slider.closest('slider-component');
          const prevButton = sliderComponent?.querySelector('button[name="previous"]');
          const nextButton = sliderComponent?.querySelector('button[name="next"]');
          if (!prevButton || !nextButton) return;

          let frame = null;

          const syncButtonState = () => {
            frame = null;
            const firstSlide = slider.querySelector('[id^="Slide-"]');
            const lastSlide = slider.querySelector('[id^="Slide-"]:last-child');
            const sliderBounds = slider.getBoundingClientRect();
            const firstBounds = firstSlide?.getBoundingClientRect();
            const lastBounds = lastSlide?.getBoundingClientRect();
            const atStart =
              Math.round(slider.scrollLeft) <= 2 ||
              (firstBounds && firstBounds.left >= sliderBounds.left - 1);
            const atEnd =
              Math.ceil(slider.scrollLeft + slider.clientWidth) >= Math.floor(slider.scrollWidth - 2) ||
              (lastBounds && lastBounds.right <= sliderBounds.right + 1);

            if (atStart) {
              prevButton.setAttribute('disabled', 'disabled');
            } else {
              prevButton.removeAttribute('disabled');
            }

            if (atEnd) {
              nextButton.setAttribute('disabled', 'disabled');
            } else {
              nextButton.removeAttribute('disabled');
            }
          };

          const requestSync = () => {
            if (frame !== null) return;
            frame = window.requestAnimationFrame(syncButtonState);
          };

          slider.addEventListener('scroll', requestSync, { passive: true });
          window.addEventListener('resize', requestSync);
          prevButton.addEventListener('click', () => window.setTimeout(requestSync, 120));
          nextButton.addEventListener('click', () => window.setTimeout(requestSync, 120));
          window.addEventListener('load', requestSync, { once: true });
          window.setTimeout(requestSync, 0);
          window.setTimeout(requestSync, 150);
          window.setTimeout(requestSync, 350);
          requestSync();
        })();
      </script>
    {%- endif -%}

    {%- if section.settings.show_view_all and section.blocks.size < collections.size -%}
      <div
        class="center collection-list-view-all{% if show_mobile_slider %} small-hide medium-hide{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        <a
          href="{{ routes.collections_url }}"
          class="button"
          id="ViewAllButton-{{ section.id }}"
          aria-labelledby="ViewAllButton-{{ section.id }} SectionHeading-{{ section.id }}"
        >
          {{- 'sections.collection_list.view_all' | t -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "t:sections.collection-list.name",
  "tag": "section",
  "class": "section section-collection-list",
  "max_blocks": 15,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "render_only_collection_handle",
      "label": "Render only on collection handle",
      "info": "Optional. Leave blank to show everywhere."
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "t:sections.collection-list.settings.title.default",
      "label": "t:sections.collection-list.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "header",
      "content": "t:sections.collection-list.settings.header_layout.content"
    },    
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.collection-list.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.collection-list.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.collection-list.settings.image_ratio.options__3.label"
        }
      ],
      "default": "square",
      "label": "t:sections.collection-list.settings.image_ratio.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "t:sections.collection-list.settings.columns_desktop.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": false,
      "label": "t:sections.collection-list.settings.show_view_all.label",
      "info": "t:sections.collection-list.settings.show_view_all.info"   
    },
    {
      "type": "header",
      "content": "t:sections.collection-list.settings.header_mobile.content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:sections.collection-list.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.collection-list.settings.columns_mobile.options__2.label"
        }
      ],
      "default": "1",
      "label": "t:sections.collection-list.settings.columns_mobile.label"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "default": false,
      "label": "t:sections.collection-list.settings.swipe_on_mobile.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "featured_collection",
      "name": "t:sections.collection-list.blocks.featured_collection.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.collection-list.blocks.featured_collection.settings.collection.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection-list.presets.name",
      "blocks": [
        {
          "type": "featured_collection"
        },
        {
          "type": "featured_collection"
        },
        {
          "type": "featured_collection"
        }
      ]
    }
  ]
}
{% endschema %}
