                        {%- endif -%}
                        <slideshow-component class="slider-mobile-gutter">
                          {%- assign number_of_slides = recommendations.products_count
                            | plus: 0.0
                            | divided_by: block.settings.products_per_page
                            | ceil
                          -%}
                          <div
                            id="Slider-{{ block.id }}"
                            class="contains-card contains-card--product complementary-slider grid grid--1-col slider slider--everywhere"
                            role="list"
                            {% if number_of_slides > 1 %}
                              aria-label="{{ 'general.slider.name' | t }}"
                            {% endif %}
                          >
                            {% assign skip_card_product_styles = false %}
                            {%- for i in (1..number_of_slides) -%}
                              <div
                                id="Slide-{{ block.id }}-{{ forloop.index }}"
                                class="complementary-slide complementary-slide--{{ settings.card_style }} grid__item slider__slide slideshow__slide"
                                tabindex="-1"
                                role="group"
                                {% if number_of_slides > 1 %}
                                  aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
                                  aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                                {% endif %}
                              >
                                <ul class="list-unstyled" role="list">
                                  {%- for product in recommendations.products
                                    limit: block.settings.products_per_page
                                    offset: continue
                                  -%}
                                    <li>
                                      {%- if block.settings.enable_quick_add -%}
                                        {% assign quick_add = 'standard' %}
                                      {%- else -%}
                                        {% assign quick_add = 'none' %}
                                      {%- endif -%}
                                      {% render 'card-product',
                                        card_product: product,
                                        media_aspect_ratio: block.settings.image_ratio,
                                        show_secondary_image: false,
                                        lazy_load: false,
                                        skip_styles: skip_card_product_styles,
                                        quick_add: quick_add,
                                        section_id: section.id,
                                        horizontal_class: true,
                                        horizontal_quick_add: true
                                      %}
                                    </li>
                                    {%- assign skip_card_product_styles = true -%}
                                  {%- endfor -%}
                                </ul>
                              </div>
                            {%- endfor -%}
                          </div>
                          {%- if number_of_slides > 1 -%}
                            <div class="slider-buttons">
                              <button
                                type="button"
                                class="slider-button slider-button--prev"
                                name="previous"
                                aria-label="{{ 'general.slider.previous_slide' | t }}"
                              >
                                <span class="svg-wrapper">
                                  {{- 'icon-caret.svg' | inline_asset_content -}}
                                </span>
                              </button>
                              <div class="slider-counter slider-counter--{{ block.settings.pagination_style }}{% if block.settings.pagination_style == 'counter' or block.settings.pagination_style == 'numbers' %} caption{% endif %}">
                                {%- if block.settings.pagination_style == 'counter' -%}
                                  <span class="slider-counter--current">1</span>
                                  <span aria-hidden="true"> / </span>
                                  <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
                                  <span class="slider-counter--total">{{ number_of_slides }}</span>
                                {%- else -%}
                                  <div class="slideshow__control-wrapper">
                                    {%- for i in (1..number_of_slides) -%}
                                      <button
                                        class="slider-counter__link slider-counter__link--{{ block.settings.pagination_style }} link"
                                        aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                                        aria-controls="Slider-{{ block.id }}"
                                      >
                                        {%- if block.settings.pagination_style == 'numbers' -%}
                                          {{ forloop.index -}}
                                        {%- else -%}
                                          <span class="dot"></span>
                                        {%- endif -%}
                                      </button>
                                    {%- endfor -%}
                                  </div>
                                {%- endif -%}
                              </div>
                              <button
                                type="button"
                                class="slider-button slider-button--next"
                                name="next"
                                aria-label="{{ 'general.slider.next_slide' | t }}"
                              >
                                <span class="svg-wrapper">
                                  {{- 'icon-caret.svg' | inline_asset_content -}}
                                </span>
                              </button>
                            </div>
                          {%- endif -%}
                        </slideshow-component>
                        {%- if block.settings.make_collapsible_row -%}
                          </details>
                        {%- endif -%}
                      </div>
                    </aside>
                  {%- endif -%}
                  {{ 'component-card.css' | asset_url | stylesheet_tag }}
                  {{ 'component-complementary-products.css' | asset_url | stylesheet_tag }}
                  {%- if block.settings.enable_quick_add -%}
                    {{ 'quick-add.css' | asset_url | stylesheet_tag }}
                    <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
                  {%- endif -%}
                </product-recommendations>
              {%- when 'icon-with-text' -%}
                {% render 'icon-with-text', block: block %}
            {%- endcase -%}
          {%- endfor -%}
          <a href="{{ product.url }}" class="link product__view-details animate-arrow">
            {{ 'products.product.view_full_details' | t }}
            {{- 'icon-arrow.svg' | inline_asset_content -}}
          </a>
        </section>
      </div>
    </div>
    <div class="product-gallery-links product-gallery-links--mobile" aria-label="Productinformatie">
      <button class="product-gallery-links__button is-active" type="button" aria-pressed="true" data-product-gallery-tab="designed-for">Ontworpen voor</button>
      <button class="product-gallery-links__button" type="button" aria-pressed="false" data-product-gallery-tab="description">Beschrijving</button>
      <button class="product-gallery-links__button" type="button" aria-pressed="false" data-product-gallery-tab="features">Functies</button>
    </div>
    <div class="product-gallery-tab-content" data-product-gallery-tab-content>
      <div class="product-gallery-tab-panel" data-product-gallery-tab-panel="designed-for">
        <p class="product-gallery-tab-text">
          Onze T-shirts worden gemaakt met zorg voor mens en milieu. Ze worden geproduceerd onder veilige en eerlijke arbeidsomstandigheden, waarbij een eerlijke prijs wordt betaald voor de kleding die we inkopen. De ontwerpen printen wij zelf hier in Apeldoorn, zodat we jullie duurzame en eerlijke kleding kunnen aanbieden voor een eerlijke prijs.
        </p>
        <div class="product-gallery-benefits" aria-label="Producteigenschappen">
          <div class="product-gallery-benefit">
            <span class="product-gallery-benefit__icon" aria-hidden="true">
              <img src="{{ 'quality-star-icon.png' | asset_url }}" alt="" loading="lazy">
            </span>
            <span class="product-gallery-benefit__content">
              <span class="product-gallery-benefit__title">Goede kwaliteit</span>
              <span class="product-gallery-benefit__description">Wij zorgen niet alleen voor eerlijke kleding, maar ook voor de beste kwaliteit. Zowel het textiel als de print worden met zorg geselecteerd en geproduceerd, zodat de kleding net als vroeger gemaakt is om lang mee te gaan.</span>
            </span>
          </div>
          <div class="product-gallery-benefit">
            <span class="product-gallery-benefit__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false">
                <path d="M6.3 13.1c0-5.5 5.1-8.8 11.7-8.7.1 6.8-3.2 11.9-8.8 11.9-1.1 0-2.1-.3-2.9-.9Z" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M4.4 19.6c2.6-5.1 6.4-7.5 11.2-9.5" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round"/>
              </svg>
            </span>
            <span class="product-gallery-benefit__content">
              <span class="product-gallery-benefit__title">100% biologisch katoen</span>
              <span class="product-gallery-benefit__description">Deze T-shirts zijn gemaakt van 100% biologisch katoen, wat beter is voor het milieu én voor uw gezondheid. Daarnaast is katoen een natuurlijk materiaal dat langer meegaat, goed ademt en dat helpt om zweet te verkomen.</span>
            </span>
          </div>
          <div class="product-gallery-benefit">
            <span class="product-gallery-benefit__icon" aria-hidden="true">
              <img src="{{ 'recycling-icon.png' | asset_url }}" alt="" loading="lazy">
            </span>
            <span class="product-gallery-benefit__content">
              <span class="product-gallery-benefit__title">100% recyclebaar</span>
              <span class="product-gallery-benefit__description">Wij verkopen alleen kleding die lang meegaat en 100% recyclebaar is. We selecteren uitsluitend textiel waarmee dit mogelijk is en printen onze ontwerpen in de hoogste kwaliteit die op de markt beschikbaar is. Zo blijft de print goed zitten en behoudt de stof zijn natuurlijke textuur, ongeacht hoe groot de print is. Dit is belangrijk, want wanneer de textuur van de stof wordt verstoord, is het textiel vaak niet meer goed recyclebaar.</span>
            </span>
          </div>
        </div>
      </div>
      <div class="product-gallery-tab-panel" data-product-gallery-tab-panel="description" hidden>
        <div class="product-gallery-description">
          <div class="product-gallery-description__group">
            <h3 class="product-gallery-description__heading">GEWICHT EN SAMENSTELLING</h3>
            <p class="product-gallery-description__text">180 g/m²<br>100% katoen</p>
          </div>
          <div class="product-gallery-description__group">
            <h3 class="product-gallery-description__heading">Pasvorm</h3>
            <p class="product-gallery-description__text">Het shirt valt mooi over de schouders en heeft een sportieve, maar toch comfortabele en relaxte pasvorm.</p>
          </div>
          <div class="product-gallery-description__group">
            <h3 class="product-gallery-description__heading">Over het product</h3>
            <p class="product-gallery-description__text">WOG staat voor Warrior Of God. Als christen is het mijn doel om Gods woord zichtbaar te maken in het dagelijks leven, zodat je niet vergeet dat je er nooit alleen voor staat.</p>
            <p class="product-gallery-description__text">Onze kleding is gemaakt van 100% biologisch katoen en staat voor kwaliteit, duurzaamheid en geloof. WOG-kleding is ontworpen voor christenen, maar is natuurlijk ook prima te dragen voor iedereen die waarde hecht aan eerlijke en biologische kleding.</p>
            <p class="product-gallery-description__text">WOG is een christelijk kledingmerk dat stijl, geloof en duurzaamheid samenbrengt.</p>
          </div>
        </div>
      </div>
      <div class="product-gallery-tab-panel" data-product-gallery-tab-panel="features" hidden></div>
    </div>

    {% render 'product-media-modal', variant_images: variant_images %}

    {% assign popups = section.blocks | where: 'type', 'popup' %}
    {%- for block in popups -%}
      <modal-dialog id="PopupModal-{{ block.id }}" class="product-popup-modal" {{ block.shopify_attributes }}>
        <div
          role="dialog"
          aria-label="{{ block.settings.text }}"
          aria-modal="true"
          class="product-popup-modal__content"
          tabindex="-1"
        >
          <button
            id="ModalClose-{{ block.id }}"
            type="button"
            class="product-popup-modal__toggle"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {{- 'icon-close.svg' | inline_asset_content -}}
          </button>
          <div class="product-popup-modal__content-info">
            <h1 class="h2">{{ block.settings.page.title | escape }}</h1>
            {{ block.settings.page.content }}
          </div>
