<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }

    @media screen and (min-width: 990px) {
      #MainProduct-{{ section.id }}.section-{{ section.id }}-padding {
        padding-top: 0;
      }

      #MainProduct-{{ section.id }} .page-width,
      #MainProduct-{{ section.id }} .product {
        margin-top: 0 !important;
        padding-top: 0 !important;
      }

      #MainProduct-{{ section.id }} .product__media-wrapper {
        --product-gallery-left-offset: calc(((100vw - min(100vw, var(--page-width))) / 2) + 5rem);
        --product-gallery-visual-lift: 3.4rem;
        align-self: flex-start;
        height: calc(100vh - var(--header-height, 0px) + var(--product-gallery-visual-lift));
        margin-top: 0 !important;
        overflow: visible;
        position: sticky;
        top: var(--header-height, 0px);
        transform: none;
      }

      #MainProduct-{{ section.id }} .product-gallery-scroll {
        direction: rtl;
        display: block;
        height: calc(100% + var(--product-gallery-visual-lift));
        margin-left: calc(-1 * var(--product-gallery-left-offset));
        margin-top: 0 !important;
        overflow-x: hidden;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding-top: 0 !important;
        scrollbar-width: none;
        transform: translateY(calc(-1 * var(--product-gallery-visual-lift)));
        width: calc(100% + var(--product-gallery-left-offset));
      }

      #MainProduct-{{ section.id }} .product-gallery-scroll::-webkit-scrollbar {
        height: 0;
        width: 0;
      }

      #MainProduct-{{ section.id }} .product-gallery-scroll::-webkit-scrollbar-track {
        background: transparent;
      }

      #MainProduct-{{ section.id }} .product-gallery-scroll::-webkit-scrollbar-thumb {
        background: rgba(0, 0, 0, 0.32);
        border-radius: 999px;
      }

      #MainProduct-{{ section.id }} .product-gallery-scroll media-gallery {
        direction: ltr;
        display: block;
        margin-top: 0 !important;
        min-height: 100%;
        padding-top: 0 !important;
      }

      #MainProduct-{{ section.id }} .product__media-list,
      #MainProduct-{{ section.id }} #GalleryViewer-{{ section.id }} {
        margin-top: 0 !important;
        padding-top: 0 !important;
      }

      #MainProduct-{{ section.id }} .product-gallery-links {
        align-items: center;
        direction: ltr;
        display: flex !important;
        font-family: var(--font-body-family);
        font-size: 1.52rem;
        font-style: var(--font-body-style);
        font-weight: 620;
        gap: clamp(1.65rem, 2.1vw, 3rem);
        left: calc(-1 * var(--product-gallery-left-offset) + 2.4rem);
        letter-spacing: 0.16em;
        line-height: 1.2;
        margin: 0;
        padding: 0 0 3.2rem 0;
        position: absolute;
        text-transform: uppercase;
        top: calc(100% + clamp(2.4rem, 3vw, 4rem));
        white-space: nowrap;
      }

      #MainProduct-{{ section.id }} .product-gallery-links__button {
        appearance: none;
        background: none;
        border: 0;
        color: rgba(0, 0, 0, 0.24);
        cursor: pointer;
        font: inherit;
        letter-spacing: inherit;
        line-height: inherit;
        padding: 0 0 0.45rem;
        position: relative;
        transition: color 180ms ease;
      }

      #MainProduct-{{ section.id }} .product-gallery-links__button::after {
        background: currentColor;
        bottom: 0;
        content: '';
        height: 0.14rem;
        left: 0;
        opacity: 0;
        position: absolute;
        transform: scaleX(0.65);
        transform-origin: center;
        transition: opacity 180ms ease, transform 180ms ease;
        width: 100%;
      }

      #MainProduct-{{ section.id }} .product-gallery-links__button.is-active {
        color: #000;
      }

      #MainProduct-{{ section.id }} .product-gallery-links__button:hover {
        color: #000;
      }

      #MainProduct-{{ section.id }} .product-gallery-links__button.is-active::after {
        opacity: 1;
        transform: scaleX(1);
      }

      #MainProduct-{{ section.id }} .product-gallery-tab-content {
        box-sizing: border-box;
        direction: ltr;
        display: block;
        margin-left: calc(-1 * (((100vw - min(100vw, var(--page-width))) / 2) + 5rem) + 2.4rem);
        margin-top: clamp(7rem, 8vw, 11rem);
        max-width: min(92rem, calc(100vw - 4.8rem));
      }

      #MainProduct-{{ section.id }} .product-gallery-tab-panel[hidden] {
        display: none !important;
      }

      #MainProduct-{{ section.id }} .product-gallery-tab-text {
        color: rgba(0, 0, 0, 0.76);
        font-family: var(--font-body-family);
        font-size: clamp(1.55rem, 1.08vw, 1.75rem);
        font-style: var(--font-body-style);
        font-weight: 440;
        letter-spacing: 0;
        line-height: 1.68;
        margin: 0;
        max-width: 74rem;
      }

      #MainProduct-{{ section.id }} .product-gallery-description {
        display: flex;
        flex-direction: column;
        gap: 2.2rem;
        max-width: 74rem;
      }

      #MainProduct-{{ section.id }} .product-gallery-description__group {
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
      }

      #MainProduct-{{ section.id }} .product-gallery-description__heading {
        color: #000;
        font-family: var(--font-body-family);
        font-size: 1.38rem;
        font-style: var(--font-body-style);
        font-weight: 700;
        letter-spacing: 0.16em;
        line-height: 1.2;
        margin: 0;
        text-transform: uppercase;
      }

      #MainProduct-{{ section.id }} .product-gallery-description__text {
        color: rgba(0, 0, 0, 0.68);
        font-family: var(--font-body-family);
        font-size: 1.42rem;
        font-weight: 360;
        letter-spacing: 0;
        line-height: 1.55;
        margin: 0;
      }

      #MainProduct-{{ section.id }} .product-gallery-benefits {
        display: flex;
        flex-direction: column;
        gap: 1.55rem;
        margin-top: 3.2rem;
      }

      #MainProduct-{{ section.id }} .product-gallery-benefit {
        align-items: flex-start;
        color: rgba(0, 0, 0, 0.74);
        display: flex;
        font-family: var(--font-body-family);
        font-size: 1.45rem;
        font-style: var(--font-body-style);
        font-weight: 430;
        gap: 1.35rem;
        letter-spacing: 0;
        line-height: 1.35;
      }

      #MainProduct-{{ section.id }} .product-gallery-benefit__content {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        padding-top: 0.2rem;
      }

      #MainProduct-{{ section.id }} .product-gallery-benefit__title {
        color: #000;
        font-family: var(--font-body-family);
        font-size: 1.38rem;
        font-style: var(--font-body-style);
        font-weight: 700;
        letter-spacing: 0.16em;
        line-height: 1.2;
        text-transform: uppercase;
      }

      #MainProduct-{{ section.id }} .product-gallery-benefit__description {
        color: rgba(0, 0, 0, 0.68);
        font-size: 1.42rem;
        font-weight: 360;
        line-height: 1.45;
        margin: 0;
        max-width: 64rem;
      }

      #MainProduct-{{ section.id }} .product-gallery-benefit__icon {
        align-items: center;
        color: #000;
        display: inline-flex;
        flex: 0 0 auto;
        height: 3.6rem;
        justify-content: center;
        width: 3.6rem;
      }

      #MainProduct-{{ section.id }} .product-gallery-benefit__icon svg,
      #MainProduct-{{ section.id }} .product-gallery-benefit__icon img {
        display: block;
        height: 2.55rem;
        width: 2.55rem;
      }

      #MainProduct-{{ section.id }} .product-gallery-links--mobile {
        display: none !important;
      }

      #MainProduct-{{ section.id }} .product__media-wrapper .slider-buttons {
        display: none !important;
      }

      #MainProduct-{{ section.id }} .product-gallery-scroll-indicator {
        --gallery-scroll-progress: 0;
        align-items: center;
        color: rgba(0, 0, 0, 0.68);
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        justify-content: center;
        left: calc(-1 * var(--product-gallery-left-offset) + 3rem);
        pointer-events: none;
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 3.6rem;
        z-index: 2;
      }

      #MainProduct-{{ section.id }} .product-gallery-scroll-indicator svg {
        display: block;
        height: 1.15rem;
        width: 1.15rem;
      }

      #MainProduct-{{ section.id }} .product-gallery-scroll-indicator__arrow,
      #MainProduct-{{ section.id }} .product-gallery-scroll-indicator__track {
        background: rgba(255, 255, 255, 0.92);
        box-shadow: 0 0.6rem 1.8rem rgba(0, 0, 0, 0.1);
      }

      #MainProduct-{{ section.id }} .product-gallery-scroll-indicator__arrow {
        align-items: center;
        border-radius: 50%;
        display: flex;
        height: 3.6rem;
        justify-content: center;
        width: 3.6rem;
      }

      #MainProduct-{{ section.id }} .product-gallery-scroll-indicator__track {
        align-items: center;
        background: rgba(255, 255, 255, 0.92);
        border-radius: 999px;
        display: flex;
        height: 14rem;
        justify-content: center;
        overflow: visible;
        padding: 1.55rem 0;
        position: relative;
        width: 3.6rem;
      }

      #MainProduct-{{ section.id }} .product-gallery-scroll-indicator__track::before {
        background: rgba(0, 0, 0, 0.18);
        border-radius: 999px;
        content: '';
        height: 10.9rem;
        width: 0.5rem;
      }

      #MainProduct-{{ section.id }} .product-gallery-scroll-indicator__thumb {
        background: rgba(0, 0, 0, 0.72);
        border-radius: 999px;
        height: 1.65rem;
        left: 50%;
        position: absolute;
        top: calc(1.55rem + (10.9rem - 1.65rem) * var(--gallery-scroll-progress));
        transform: translateX(-50%);
        transition: top 80ms linear;
        width: 0.5rem;
      }

      #MainProduct-{{ section.id }} .product__info-wrapper {
        left: clamp(20rem, 22vw, 37rem);
        position: relative;
        transform: none !important;
      }

      #MainProduct-{{ section.id }} .product__info-container {
        padding-top: clamp(3.6rem, 4.5vw, 6.8rem);
      }

      #MainProduct-{{ section.id }} .product__title--body {
        max-width: 44rem;
        width: 100%;
      }

      #MainProduct-{{ section.id }} .product__title--body h1 {
        font-size: clamp(1.75rem, 1.25vw, 2.15rem);
        line-height: 1.15;
        white-space: nowrap;
      }

      #MainProduct-{{ section.id }} .product__column-sticky {
        top: calc(var(--header-height, 0px) + clamp(3.6rem, 4.5vw, 6.8rem));
      }

      #MainProduct-{{ section.id }} .product__media-list .product__media-item:first-child,
      #MainProduct-{{ section.id }} .product__media-list .product__media-item--filtered-large {
        flex: 0 0 100% !important;
        max-width: 100% !important;
        order: 2;
        width: 100% !important;
      }

      #MainProduct-{{ section.id }} .product__media-list .product__media-item:first-child .product-media-container,
      #MainProduct-{{ section.id }} .product__media-list .product__media-item--filtered-large .product-media-container {
        width: 100% !important;
      }

      #MainProduct-{{ section.id }} .product__media-list .product__media-item:not(:first-child),
      #MainProduct-{{ section.id }} .product__media-list .product__media-item--filtered-small {
        order: 1;
      }

      #MainProduct-{{ section.id }} .product__media-item--click-zoom .product__modal-opener--image,
      #MainProduct-{{ section.id }} .product__media-item--click-zoom .product__media {
        overflow: hidden;
      }

      #MainProduct-{{ section.id }} .product__media-item--click-zoom .product__media img {
        transform-origin: center center;
        transition: transform 240ms ease, transform-origin 80ms linear;
      }

      #MainProduct-{{ section.id }} .product__media-item--click-zoom.is-click-zoomed .product__media img {
        transform: scale(1.5);
      }

      #MainProduct-{{ section.id }} .product__media-item--click-zoom-large.is-click-zoomed .product__media img {
        transform: scale(1.25);
      }

      #MainProduct-{{ section.id }} .product__media-item--click-zoom.is-click-zoomed .product-media-container.media-type-image,
      #MainProduct-{{ section.id }} .product__media-item--click-zoom.is-click-zoomed .product__modal-opener--image,
      #MainProduct-{{ section.id }} .product__media-item--click-zoom.is-click-zoomed .product__modal-opener--image .product__media,
      #MainProduct-{{ section.id }} .product__media-item--click-zoom.is-click-zoomed .product__modal-opener--image .product__media img,
      #MainProduct-{{ section.id }} .product__media-item--click-zoom.is-click-zoomed .product__modal-opener--image .product__media-toggle,
      #MainProduct-{{ section.id }} .product__media-item--click-zoom.is-click-zoomed .product__modal-opener--image .product__media-toggle::after {
        cursor: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='20' cy='20' r='17' fill='white' fill-opacity='0.94'/%3E%3Cpath d='M12.5 20h15' stroke='%23363636' stroke-width='1.7' stroke-linecap='round'/%3E%3C/svg%3E") 20 20, zoom-out !important;
      }

      #MainProduct-{{ section.id }} .product-media-container.media-type-image,
      #MainProduct-{{ section.id }} .product__modal-opener--image,
      #MainProduct-{{ section.id }} .product__modal-opener--image .product__media,
      #MainProduct-{{ section.id }} .product__modal-opener--image .product__media img,
      #MainProduct-{{ section.id }} .product__modal-opener--image .product__media-toggle,
      #MainProduct-{{ section.id }} .product__modal-opener--image .product__media-toggle::after {
        cursor: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='20' cy='20' r='17' fill='white' fill-opacity='0.94'/%3E%3Cpath d='M20 12.5v15M12.5 20h15' stroke='%23363636' stroke-width='1.7' stroke-linecap='round'/%3E%3C/svg%3E") 20 20, zoom-in !important;
      }

      #MainProduct-{{ section.id }} .product__media-icon {
        display: none !important;
      }
    }

    .product__title--body h1 {
      color: #000;
      font: inherit;
      font-weight: 700;
      letter-spacing: inherit;
      line-height: inherit;
      margin: 0;
    }

    .product__price--collection,
    .product__price--collection * {
      color: #000 !important;
      font-family: var(--font-body-family) !important;
      font-style: var(--font-body-style) !important;
      font-weight: 600 !important;
    }

    .product-gallery-progress {
      display: none;
    }

    .product-gallery-scroll-indicator {
      display: none;
    }

    .product-gallery-links {
      display: none;
    }

    .product-gallery-tab-content {
      display: none;
    }

    #MainProduct-{{ section.id }} .product__media-item.is-product-media-filtered,
    #MainProduct-{{ section.id }} .thumbnail-list__item.is-product-media-filtered {
      display: none !important;
    }

    #MainProduct-{{ section.id }} .product-form__submit {
      border-radius: 999px;
    }

    #MainProduct-{{ section.id }} .product-form__empty-container {
      align-items: center;
      background: #fff;
      border: 0.1rem solid rgba(0, 0, 0, 0.16);
      border-radius: 0;
      box-sizing: border-box;
      display: flex;
      gap: 1.15rem;
      margin-top: 2.6rem;
      min-height: 3.55rem;
      padding: 0 1.6rem;
      width: 100%;
    }

    #MainProduct-{{ section.id }} .product-form__empty-container svg {
      color: #000;
      display: block;
      flex: 0 0 auto;
      height: 1.9rem;
      width: 3.4rem;
    }

    #MainProduct-{{ section.id }} .product-form__empty-container-text {
      color: rgba(0, 0, 0, 0.68);
      font-family: var(--font-body-family);
      font-size: 1.3rem;
      font-style: var(--font-body-style);
      font-weight: 400;
      letter-spacing: 0;
      line-height: 1;
      white-space: nowrap;
    }

    #MainProduct-{{ section.id }} .product-form__buttons + .product-form__empty-container {
      max-width: 44rem;
    }

    #MainProduct-{{ section.id }} .product-form__description-heading {
      align-items: center;
      appearance: none;
      border-bottom: 0.1rem solid rgba(0, 0, 0, 0.12);
      border-left: 0;
      border-right: 0;
      border-top: 0;
      background: transparent;
      color: #000;
      display: flex;
      font-family: var(--font-body-family);
      font-size: 1.45rem;
      font-style: var(--font-body-style);
      font-weight: 600;
      justify-content: space-between;
      letter-spacing: 0;
      line-height: 1.2;
      margin-top: 1.6rem;
      max-width: 44rem;
      padding-left: 0;
      padding-right: 0;
      padding-bottom: 1.3rem;
      position: relative;
      text-align: left;
      transition: border-color 220ms ease, box-shadow 340ms ease;
      width: 100%;
    }

    #MainProduct-{{ section.id }} .product-form__description-heading > span {
      transition: transform 220ms ease;
    }

    #MainProduct-{{ section.id }} .product-form__description-heading-icon {
      color: #000;
      height: 1rem;
      transform: rotate(-90deg) translateX(0);
      transform-origin: center;
      width: 1rem;
    }

    #MainProduct-{{ section.id }} .product-form__description-heading-icon svg {
      display: block;
      height: 100%;
      width: 100%;
    }

    #MainProduct-{{ section.id }} .product-info-drawer {
      display: none;
    }

    .product-info-drawer__cart-added {
      color: #000;
      display: flex;
      flex-direction: column;
      font-family: var(--font-body-family);
      gap: 2.4rem;
      min-height: 100%;
    }

    .product-info-drawer__checkout-anchor {
      display: flex;
      flex-direction: column;
      margin-top: auto;
    }

    .product-info-drawer__cart-message {
      color: rgba(0, 0, 0, 0.68);
      font-size: 1.42rem;
      font-weight: 360;
      line-height: 1.5;
      margin: 0;
    }

    .product-info-drawer__shipping-tracker {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding-bottom: 1.8rem;
    }

    .product-info-drawer__shipping-title {
      color: #000;
      font-size: 1.34rem;
      font-weight: 620;
      line-height: 1.25;
      margin: 0;
    }

    .product-info-drawer__shipping-message {
      color: rgba(0, 0, 0, 0.62);
      font-size: 1.25rem;
      font-weight: 360;
      line-height: 1.4;
      margin: 0;
    }

    .product-info-drawer__shipping-track {
      background: rgba(0, 0, 0, 0.09);
      border-radius: 999px;
      height: 0.55rem;
      overflow: hidden;
      position: relative;
      width: 100%;
    }

    .product-info-drawer__shipping-progress {
      background: linear-gradient(90deg, #1f6fff 0%, #66a6ff 100%);
      border-radius: inherit;
      display: block;
      height: 100%;
      transition: width 1100ms cubic-bezier(0.22, 1, 0.36, 1);
      width: var(--shipping-progress, 0%);
    }

    .product-info-drawer__shipping-tracker.is-complete .product-info-drawer__shipping-progress {
      background: linear-gradient(90deg, #15803d 0%, #4ade80 100%);
    }

    .product-info-drawer__cart-item {
      align-items: center;
      border-top: 0.1rem solid rgba(0, 0, 0, 0.1);
      display: grid;
      gap: 1.6rem;
      grid-template-columns: 8.8rem minmax(0, 1fr);
      padding: 1.8rem 0;
    }

    .product-info-drawer__cart-list {
      display: flex;
      flex-direction: column;
    }

    .product-info-drawer__cart-image {
      background: rgba(0, 0, 0, 0.03);
      display: block;
      height: 11rem;
      object-fit: cover;
      width: 8.8rem;
    }

    .product-info-drawer__upsells {
      border-top: 0.1rem solid rgba(0, 0, 0, 0.1);
      display: flex;
      flex-direction: column;
      gap: 1.05rem;
      padding-top: 1.45rem;
    }

    .product-info-drawer__upsells-title {
      color: #000;
      font-size: 1.28rem;
      font-weight: 560;
      line-height: 1.25;
      margin: 0;
    }

    .product-info-drawer__upsell-list {
      display: grid;
      gap: 0.9rem;
    }

    .product-info-drawer__upsell {
      align-items: center;
      cursor: pointer;
      display: grid;
      gap: 1rem;
      grid-template-columns: 5.6rem minmax(0, 1fr) 3.4rem;
    }

    .product-info-drawer__upsell-image {
      background: rgba(0, 0, 0, 0.035);
      display: block;
      height: 6.8rem;
      object-fit: contain;
      width: 5.6rem;
    }

    .product-info-drawer__upsell-details {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      min-width: 0;
    }

    .product-info-drawer__upsell-title,
    .product-info-drawer__upsell-price {
      margin: 0;
    }

    .product-info-drawer__upsell-title {
      color: #000;
      font-size: 1.22rem;
      font-weight: 520;
      line-height: 1.25;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .product-info-drawer__upsell-price {
      color: rgba(0, 0, 0, 0.58);
