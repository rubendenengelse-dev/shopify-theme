      </modal-dialog>
    {%- endfor -%}

    {%- if product.media.size > 0 -%}
      <script src="{{ 'product-modal.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if first_3d_model -%}
      <script type="application/json" id="ProductJSON-{{ product.id }}">
        {{ product.media | where: 'media_type', 'model' | json }}
      </script>
      <script src="{{ 'product-model.js' | asset_url }}" defer></script>
    {%- endif -%}

    {%- liquid
      if product.selected_or_first_available_variant.featured_media
        assign seo_media = product.selected_or_first_available_variant.featured_media
      else
        assign seo_media = product.featured_media
      endif
    -%}

  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
  <script>
    (() => {
      const root = document.getElementById('MainProduct-{{ section.id }}');
      const viewer = root?.querySelector('#GalleryViewer-{{ section.id }}');
      const slider = root?.querySelector('#Slider-Gallery-{{ section.id }}');
      const dots = root?.querySelector('[data-product-gallery-dots]');
      let dotItems = dots ? Array.from(dots.querySelectorAll('[data-product-gallery-dot]')) : [];
      const galleryScroll = root?.querySelector('.product-gallery-scroll');
      const galleryScrollIndicator = root?.querySelector('.product-gallery-scroll-indicator');
      const galleryLinkButtons = root ? Array.from(root.querySelectorAll('.product-gallery-links__button')) : [];
      const galleryTabPanels = root ? Array.from(root.querySelectorAll('[data-product-gallery-tab-panel]')) : [];
      const drawer = root?.querySelector('[data-product-info-drawer]');
      const productMediaModal = document.getElementById('ProductModal-{{ section.id }}');
      if (drawer && drawer.parentElement !== document.body) {
        document.body.appendChild(drawer);
      }
      const drawerTitle = drawer?.querySelector('[data-product-info-drawer-title]');
      const drawerBody = drawer?.querySelector('[data-product-info-drawer-body]');
      const drawerTriggers = root ? Array.from(root.querySelectorAll('[data-product-info-drawer-trigger]')) : [];
      const drawerCloseButtons = drawer ? Array.from(drawer.querySelectorAll('[data-product-info-drawer-close]')) : [];
      const desktopDrawerMedia = window.matchMedia('(min-width: 750px)');
      const desktopGalleryZoomMedia = window.matchMedia('(min-width: 990px)');
      const mobileProductMedia = window.matchMedia('(max-width: 749px)');
      let drawerShippingProgress = null;
      let lastDrawerCartContent = '';

      const setGalleryProgressDotCount = (count) => {
        if (!dots) return;
        const track = dots.querySelector('.product-gallery-progress__track');
        if (!track) return;
        const normalizedCount = Math.max(count, 1);
        const currentCount = track.querySelectorAll('[data-product-gallery-dot]').length;
        if (currentCount === normalizedCount) return;

        track.innerHTML = '';
        for (let index = 0; index < normalizedCount; index += 1) {
          const dot = document.createElement('span');
          dot.className = 'product-gallery-progress__dot';
          dot.dataset.productGalleryDot = '';
          dot.style.setProperty('--dot-progress', index === 0 ? '1' : '0');
          dot.style.setProperty('--dot-muted-opacity', index === 0 ? '0' : '1');
          dot.style.setProperty('--dot-line-opacity', index === 0 ? '1' : '0');
          dot.style.setProperty('--dot-active-width', '16.5px');
          track.appendChild(dot);
        }
        dotItems = Array.from(track.querySelectorAll('[data-product-gallery-dot]'));
        dots.style.setProperty('--media-count', String(normalizedCount));
      };

      const closeInfoDrawer = () => {
        if (!drawer) return;
        drawer.classList.remove('is-open');
        drawer.setAttribute('aria-hidden', 'true');
        drawer.removeAttribute('data-product-info-drawer-active-title');
        document.documentElement.classList.remove('product-info-drawer-open');
        drawerShippingProgress = null;
      };

      const returnToDrawerCart = () => {
        if (lastDrawerCartContent) {
          openInfoDrawer('WINKELWAGEN', lastDrawerCartContent);
          animateShippingProgress();
          return;
        }
        closeInfoDrawer();
      };

      const openInfoDrawer = (title, content = '') => {
        if (!drawer) return;
        if (drawerTitle) drawerTitle.textContent = title;
        if (drawerBody) drawerBody.innerHTML = content;
        drawer.setAttribute('data-product-info-drawer-active-title', title);
        drawer.classList.add('is-open');
        drawer.setAttribute('aria-hidden', 'false');
        document.documentElement.classList.add('product-info-drawer-open');
      };

      const animateShippingProgress = () => {
        const progress = drawerBody?.querySelector('[data-shipping-progress]');
        if (!progress) return;
        const targetProgress = progress.dataset.shippingProgress;
        window.requestAnimationFrame(() => {
          window.requestAnimationFrame(() => {
            progress.style.setProperty('--shipping-progress', `${targetProgress}%`);
            drawerShippingProgress = targetProgress;
          });
        });
      };

      const escapeDrawerHTML = (value = '') =>
        String(value).replace(/[&<>"']/g, (character) => {
          return {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;',
          }[character];
        });

      const formatDrawerMoney = (value) => {
        const amount = Number(value || 0) / 100;
        return new Intl.NumberFormat('nl-NL', {
          style: 'currency',
          currency: {{ cart.currency.iso_code | json }},
        }).format(amount);
      };

      const getDrawerCartState = async () => {
        try {
          const cartResponse = await fetch(`${window.routes?.cart_url || '/cart'}.js`, {
            headers: { Accept: 'application/json' },
          });
          if (cartResponse.ok) return await cartResponse.json();
        } catch (error) {
          return {};
        }
        return {};
      };

      const updateDrawerCartIcon = (cartState = {}) => {
        const cartIconSection = cartState.sections?.['cart-icon-bubble'];
        if (!cartIconSection) return;
        const cartIcon = document.getElementById('shopify-section-cart-icon-bubble');
        const updatedCartIcon = new DOMParser()
          .parseFromString(cartIconSection, 'text/html')
          .getElementById('shopify-section-cart-icon-bubble');
        if (cartIcon && updatedCartIcon) cartIcon.innerHTML = updatedCartIcon.innerHTML;
      };

      const drawerUpsellProducts = (() => {
        const upsellScript = document.getElementById('ProductDrawerUpsells-{{ section.id }}');
        if (!upsellScript?.textContent) return [];
        try {
          return JSON.parse(upsellScript.textContent).filter((item) => item?.variantId && item?.variants?.length);
        } catch (error) {
          return [];
        }
      })();

      const getDrawerUpsellProduct = (productId) =>
        drawerUpsellProducts.find((item) => Number(item.id) === Number(productId));

      const getDrawerUpsellSizeLabel = (variant = {}) => {
        const sizeValues = ['XXS', 'XS', 'S', 'M', 'L', 'XL', 'XXL', 'XXXL', '2XL', '3XL'];
        const options = [variant.option1, variant.option2, variant.option3].filter(Boolean);
        return options.find((option) => sizeValues.includes(String(option).toUpperCase())) || variant.title || 'Maat';
      };

      const buildDrawerUpsellSizePicker = (item = {}) => {
        const variants = Array.isArray(item.variants) ? item.variants : [];
        const firstVariant = variants[0] || {};
        const pickerImage = firstVariant.image || item.image;
        const pickerPrice = firstVariant.price || item.price;
        const seenSizes = new Set();
        const sizeVariants = variants.filter((variant) => {
          const sizeLabel = getDrawerUpsellSizeLabel(variant);
          if (seenSizes.has(sizeLabel)) return false;
          seenSizes.add(sizeLabel);
          return true;
        });

        return `
          <div class="product-info-drawer__upsell-picker">
            <div class="product-info-drawer__upsell-picker-summary">
              ${
                pickerImage
                  ? `<a class="product-info-drawer__upsell-picker-image-link" href="${escapeDrawerHTML(item.url || '#')}"><img class="product-info-drawer__upsell-picker-image" src="${escapeDrawerHTML(pickerImage)}" alt="${escapeDrawerHTML(item.title)}" loading="lazy"></a>`
                  : '<span class="product-info-drawer__upsell-picker-image" aria-hidden="true"></span>'
              }
              <div class="product-info-drawer__upsell-picker-details">
                <p class="product-info-drawer__upsell-picker-title">${escapeDrawerHTML(item.title)}</p>
                <p class="product-info-drawer__upsell-picker-price">${formatDrawerMoney(pickerPrice)}</p>
              </div>
            </div>
            <p class="product-info-drawer__upsell-size-label">Selecteer een maat</p>
            <div class="product-info-drawer__upsell-size-grid">
              ${sizeVariants
                .map(
                  (variant) => `
                    <button class="product-info-drawer__upsell-size-button" type="button" data-cart-upsell-variant-id="${escapeDrawerHTML(variant.id)}">
                      ${escapeDrawerHTML(getDrawerUpsellSizeLabel(variant))}
                    </button>
                  `
                )
                .join('')}
            </div>
          </div>
        `;
      };

      const buildDrawerUpsells = (cartItems = []) => {
        const cartProductIds = new Set(cartItems.map((item) => Number(item.product_id)).filter(Boolean));
        const upsells = drawerUpsellProducts
          .filter((item) => !cartProductIds.has(Number(item.id)))
          .slice(0, 2);

        if (!upsells.length) return '';

        return `
          <div class="product-info-drawer__upsells">
            <p class="product-info-drawer__upsells-title">Misschien wil je deze ook toevoegen</p>
            <div class="product-info-drawer__upsell-list">
              ${upsells
                .map(
                  (item) => `
                    <div class="product-info-drawer__upsell" data-cart-upsell-product-id="${escapeDrawerHTML(item.id)}">
                      ${
                        item.image
                          ? `<img class="product-info-drawer__upsell-image" src="${escapeDrawerHTML(item.image)}" alt="${escapeDrawerHTML(item.title)}" loading="lazy">`
                          : '<span class="product-info-drawer__upsell-image" aria-hidden="true"></span>'
                      }
                      <div class="product-info-drawer__upsell-details">
                        <p class="product-info-drawer__upsell-title">${escapeDrawerHTML(item.title)}</p>
                        <p class="product-info-drawer__upsell-price">${formatDrawerMoney(item.price)}</p>
                      </div>
                      <button class="product-info-drawer__upsell-add" type="button" data-cart-upsell-product-id="${escapeDrawerHTML(item.id)}" aria-label="${escapeDrawerHTML(item.title)} maat kiezen">
                        <svg viewBox="0 0 12 12" focusable="false" aria-hidden="true">
                          <path d="M6 2v8M2 6h8" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round"/>
                        </svg>
                      </button>
                    </div>
                  `
                )
                .join('')}
            </div>
          </div>
        `;
      };

      const buildDrawerCartItems = (cartItems = []) => {
        if (!cartItems.length) return '';
        const sortedCartItems = [...cartItems].sort((a, b) => {
          const aIsCurrentProduct = Number(a.product_id) === {{ product.id | json }};
          const bIsCurrentProduct = Number(b.product_id) === {{ product.id | json }};
          if (aIsCurrentProduct === bIsCurrentProduct) return 0;
          return aIsCurrentProduct ? -1 : 1;
        });

        return `
          <div class="product-info-drawer__cart-list">
            ${sortedCartItems
              .map((item) => {
                const itemTitle = item.product_title || item.title || 'Product';
                const itemVariantTitle = item.variant_title && item.variant_title !== 'Default Title' ? item.variant_title : '';
                const itemImageMarkup = item.image
                  ? `<img class="product-info-drawer__cart-image" src="${escapeDrawerHTML(item.image)}" alt="${escapeDrawerHTML(itemTitle)}" loading="lazy">`
                  : '<span class="product-info-drawer__cart-image" aria-hidden="true"></span>';
                const itemLinePrice = formatDrawerMoney(item.final_line_price || item.final_price || item.price);
                const itemQuantity = Math.max(Number(item.quantity || 1), 0);

                return `
                  <div class="product-info-drawer__cart-item">
                    ${itemImageMarkup}
                    <div class="product-info-drawer__cart-details">
                      <p class="product-info-drawer__cart-title">${escapeDrawerHTML(itemTitle)}</p>
                      ${itemVariantTitle ? `<p class="product-info-drawer__cart-meta">${escapeDrawerHTML(itemVariantTitle)}</p>` : ''}
                      <p class="product-info-drawer__cart-price">${itemQuantity} x ${itemLinePrice}</p>
                      <div class="product-info-drawer__quantity" data-cart-line-key="${escapeDrawerHTML(item.key)}" data-cart-line-quantity="${itemQuantity}">
                        <button class="product-info-drawer__quantity-button" type="button" data-cart-quantity-action="minus" aria-label="Aantal verlagen">
                          <svg viewBox="0 0 12 12" focusable="false" aria-hidden="true">
                            <path d="M2 6h8" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round"/>
                          </svg>
                        </button>
                        <span class="product-info-drawer__quantity-count">${itemQuantity}</span>
                        <button class="product-info-drawer__quantity-button" type="button" data-cart-quantity-action="plus" aria-label="Aantal verhogen">
                          <svg viewBox="0 0 12 12" focusable="false" aria-hidden="true">
                            <path d="M6 2v8M2 6h8" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round"/>
                          </svg>
                        </button>
                      </div>
                    </div>
                  </div>
                `;
              })
              .join('')}
          </div>
        `;
      };

      const buildCartAddedDrawerContent = (cartData = {}, cartState = {}) => {
        const cartItems = Array.isArray(cartState.items) ? cartState.items : [];
        const freeShippingTarget = 6900;
        const standardDeliveryPrice = 495;
        const cartTotal = Number(cartState.total_price || 0);
        const remainingForFreeShipping = Math.max(freeShippingTarget - cartTotal, 0);
        const shippingProgress = Math.min((cartTotal / freeShippingTarget) * 100, 100).toFixed(2);
        const startingShippingProgress = drawerShippingProgress ?? shippingProgress;
        const shippingMessage = remainingForFreeShipping > 0
          ? `Nog ${formatDrawerMoney(remainingForFreeShipping)} tot gratis verzending.`
          : 'Je hebt gratis verzending ontgrendeld.';
        const deliveryPrice = cartTotal >= freeShippingTarget ? 0 : standardDeliveryPrice;
        const orderTotal = cartTotal + deliveryPrice;

        const drawerCartContent = `
          <div class="product-info-drawer__cart-added">
            <div class="product-info-drawer__shipping-tracker${remainingForFreeShipping === 0 ? ' is-complete' : ''}">
              <p class="product-info-drawer__shipping-title">Gratis verzending vanaf ${formatDrawerMoney(freeShippingTarget)}</p>
              <p class="product-info-drawer__shipping-message">${shippingMessage}</p>
              <div class="product-info-drawer__shipping-track" aria-hidden="true">
                <span class="product-info-drawer__shipping-progress" data-shipping-progress="${shippingProgress}" style="--shipping-progress: ${startingShippingProgress}%"></span>
              </div>
            </div>
            ${buildDrawerCartItems(cartItems)}
            ${buildDrawerUpsells(cartItems)}
            <div class="product-info-drawer__cart-actions">
              <div class="product-info-drawer__order-summary">
                <p class="product-info-drawer__summary-heading">Samenvatting van bestelling</p>
                <div class="product-info-drawer__summary-row">
                  <span>Totaal</span>
                  <span>${formatDrawerMoney(cartTotal)}</span>
                </div>
                <div class="product-info-drawer__summary-row">
                  <span>Standaard verzending</span>
                  <span>${deliveryPrice === 0 ? 'Vrij' : formatDrawerMoney(deliveryPrice)}</span>
                </div>
                <div class="product-info-drawer__summary-row product-info-drawer__summary-row--total">
                  <span>Totaal</span>
                  <span>${formatDrawerMoney(orderTotal)}</span>
                </div>
              </div>
            </div>
            <div class="product-info-drawer__checkout-anchor">
              <a class="product-info-drawer__cart-button product-info-drawer__cart-button--primary" href="/checkout">Afrekenen</a>
            </div>
          </div>
        `;
        lastDrawerCartContent = drawerCartContent;
        return drawerCartContent;
      };

      document.addEventListener('product:cart-added-drawer', async (event) => {
        if (!drawer || !root?.contains(event.detail?.productForm)) return;
        const cartState = await getDrawerCartState();
        openInfoDrawer('WINKELWAGEN', buildCartAddedDrawerContent(event.detail?.cartData, cartState));
        animateShippingProgress();
      });

      document.getElementById('cart-icon-bubble')?.addEventListener('click', async (event) => {
        if (!drawer) return;
        event.preventDefault();
        const cartState = await getDrawerCartState();
        openInfoDrawer('WINKELWAGEN', buildCartAddedDrawerContent({}, cartState));
        animateShippingProgress();
      });

      document.addEventListener('wog:open-product-cart-drawer', async (event) => {
        if (!drawer) return;
        event.preventDefault();
        const cartState = await getDrawerCartState();
        openInfoDrawer('WINKELWAGEN', buildCartAddedDrawerContent({}, cartState));
        animateShippingProgress();
      });

      drawerBody?.addEventListener('click', async (event) => {
        const upsellSizeButton = event.target.closest('[data-cart-upsell-variant-id]');
        if (upsellSizeButton) {
          const variantId = Number(upsellSizeButton.dataset.cartUpsellVariantId);
          if (!variantId) return;
          upsellSizeButton.disabled = true;

          try {
            const addResponse = await fetch(window.routes?.cart_add_url || '/cart/add.js', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                Accept: 'application/json',
              },
              body: JSON.stringify({
                id: variantId,
                quantity: 1,
                sections: 'cart-icon-bubble',
                sections_url: window.location.pathname,
              }),
            });
            if (!addResponse.ok) throw new Error('Cart upsell add failed');
            const addedItem = await addResponse.json();
            const cartState = await getDrawerCartState();
            updateDrawerCartIcon(addedItem.sections ? addedItem : cartState);
            openInfoDrawer('WINKELWAGEN', buildCartAddedDrawerContent(addedItem, cartState));
            animateShippingProgress();
          } catch (error) {
            upsellSizeButton.disabled = false;
          }
          return;
        }

        const upsellProductTrigger = event.target.closest('.product-info-drawer__upsell[data-cart-upsell-product-id], .product-info-drawer__upsell-add[data-cart-upsell-product-id]');
        if (upsellProductTrigger) {
          const upsellProduct = getDrawerUpsellProduct(upsellProductTrigger.dataset.cartUpsellProductId);
          if (!upsellProduct) return;
          openInfoDrawer('MAAT SELECTEREN', buildDrawerUpsellSizePicker(upsellProduct));
          return;
        }

        const quantityButton = event.target.closest('[data-cart-quantity-action]');
        if (!quantityButton) return;
        const quantityWrapper = quantityButton.closest('[data-cart-line-key]');
        const itemKey = quantityWrapper?.dataset.cartLineKey;
        if (!itemKey) return;

        const currentQuantity = Number(quantityWrapper.dataset.cartLineQuantity || 1);
        const nextQuantity = quantityButton.dataset.cartQuantityAction === 'plus'
          ? currentQuantity + 1
          : Math.max(currentQuantity - 1, 0);

        quantityWrapper.querySelectorAll('button').forEach((button) => {
          button.disabled = true;
        });

        try {
          const changeResponse = await fetch(window.routes?.cart_change_url || '/cart/change.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json',
            },
            body: JSON.stringify({
              id: itemKey,
              quantity: nextQuantity,
              sections: 'cart-icon-bubble',
              sections_url: window.location.pathname,
            }),
          });
          if (!changeResponse.ok) throw new Error('Cart quantity update failed');
          const cartState = await changeResponse.json();
          updateDrawerCartIcon(cartState);
          const updatedItem = cartState.items?.find((item) => item.key === itemKey);
          openInfoDrawer('WINKELWAGEN', buildCartAddedDrawerContent(updatedItem || { key: itemKey }, cartState, !updatedItem));
          animateShippingProgress();
        } catch (error) {
          quantityWrapper.querySelectorAll('button').forEach((button) => {
            button.disabled = false;
          });
        }
      });

      drawerTriggers.forEach((trigger) => {
        trigger.addEventListener('click', () => {
          const content = trigger.querySelector('[data-product-info-drawer-content]')?.innerHTML || '';
          openInfoDrawer(trigger.dataset.productInfoDrawerTitle || '', content);
        });
      });

      drawerCloseButtons.forEach((button) => {
        button.addEventListener('click', () => {
          if (drawer?.dataset.productInfoDrawerActiveTitle === 'MAAT SELECTEREN') {
            returnToDrawerCart();
            return;
          }
          closeInfoDrawer();
        });
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeInfoDrawer();
      });

      desktopDrawerMedia.addEventListener?.('change', (event) => {
        if (!event.matches) closeInfoDrawer();
      });

      const mobileMediaOpeners = root ? Array.from(root.querySelectorAll('.product__modal-opener--image')) : [];
      mobileMediaOpeners.forEach((opener) => {
        const button = opener.querySelector('.product__media-toggle');
        if (!button) return;

        opener.addEventListener('click', (event) => {
          if (!mobileProductMedia.matches || event.target.closest('.product__media-toggle')) return;
          event.preventDefault();
          event.stopPropagation();
          button.click();
        });
      });

      if (productMediaModal) {
        const modalContent = productMediaModal.querySelector('.product-media-modal__content');
        let isPanningProductMedia = false;
        let panStartX = 0;
        let panStartY = 0;
        let panX = 0;
        let panY = 0;

        const getActiveModalImage = () => productMediaModal.querySelector('.product-media-modal__content > img.active');

        const resetMobileModalPan = () => {
          isPanningProductMedia = false;
          panX = 0;
          panY = 0;
          getActiveModalImage()?.style.removeProperty('transform');
        };

        const syncMobileModalLock = () => {
          const shouldLock = mobileProductMedia.matches && productMediaModal.hasAttribute('open');
          document.documentElement.classList.toggle('product-media-modal-pan-open', shouldLock);
          if (!shouldLock) resetMobileModalPan();
        };

        const modalObserver = new MutationObserver(syncMobileModalLock);
        modalObserver.observe(productMediaModal, { attributes: true, attributeFilter: ['open'] });
        mobileProductMedia.addEventListener?.('change', syncMobileModalLock);

        const startMobileModalPan = (event) => {
          if (!mobileProductMedia.matches || !productMediaModal.hasAttribute('open') || event.touches.length !== 1) return;
          const image = getActiveModalImage();
          if (!image) return;
          isPanningProductMedia = true;
          panStartX = event.touches[0].clientX - panX;
          panStartY = event.touches[0].clientY - panY;
        };

        const moveMobileModalPan = (event) => {
          if (!isPanningProductMedia || !mobileProductMedia.matches || event.touches.length !== 1) return;
          const image = getActiveModalImage();
          if (!image) return;
          event.preventDefault();
          panX = event.touches[0].clientX - panStartX;
          panY = event.touches[0].clientY - panStartY;
          image.style.transform = `translate3d(${panX.toFixed(1)}px, ${panY.toFixed(1)}px, 0)`;
        };

        const stopMobileModalPan = () => {
          isPanningProductMedia = false;
        };

        modalContent?.addEventListener('touchstart', startMobileModalPan, { passive: true });
        modalContent?.addEventListener('touchmove', moveMobileModalPan, { passive: false });
        modalContent?.addEventListener('touchend', stopMobileModalPan);
        modalContent?.addEventListener('touchcancel', stopMobileModalPan);
        syncMobileModalLock();
      }

      let galleryScrollFrame = null;
      const updateGalleryScrollIndicator = () => {
        if (!galleryScroll || !galleryScrollIndicator) return;
        galleryScrollFrame = null;
        const maxScroll = galleryScroll.scrollHeight - galleryScroll.clientHeight;
        const progress = maxScroll > 0 ? galleryScroll.scrollTop / maxScroll : 0;
        galleryScrollIndicator.style.setProperty('--gallery-scroll-progress', Math.min(Math.max(progress, 0), 1).toFixed(4));
      };

      const requestGalleryScrollUpdate = () => {
        if (!galleryScroll || !galleryScrollIndicator || galleryScrollFrame) return;
        galleryScrollFrame = window.requestAnimationFrame(updateGalleryScrollIndicator);
      };

      if (galleryScroll && galleryScrollIndicator) {
        galleryScroll.addEventListener('scroll', requestGalleryScrollUpdate, { passive: true });
        window.addEventListener('resize', requestGalleryScrollUpdate);
        requestGalleryScrollUpdate();
      }

      galleryLinkButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const selectedTab = button.dataset.productGalleryTab;
          galleryLinkButtons.forEach((item) => {
            const isActive = item.dataset.productGalleryTab === selectedTab;
            item.classList.toggle('is-active', isActive);
            item.setAttribute('aria-pressed', String(isActive));
          });
          galleryTabPanels.forEach((panel) => {
            panel.hidden = panel.dataset.productGalleryTabPanel !== selectedTab;
          });
        });
      });

      const normalizeProductColor = (value = '') => {
        const normalized = value.trim().toLowerCase();
        if (normalized === 'zwart' || normalized === 'black') return 'black';
        if (normalized === 'wit' || normalized === 'white' || normalized === 'ivoor' || normalized === 'ivory') return 'white';
        return normalized;
      };

      const getSelectedProductColor = () => {
        const selectedColor = root?.querySelector('.product-form__input--color-option input[type="radio"]:checked');
        return selectedColor ? normalizeProductColor(selectedColor.value) : '';
      };

      let clickZoomItems = [];
      const clickZoomTeardowns = new WeakMap();
      const resetClickZoom = () => {
        clickZoomItems.forEach((item) => {
          item.classList.remove('is-click-zoomed');
          item.querySelector('.product__media img')?.style.removeProperty('transform-origin');
        });
      };

      const bindClickZoomItem = (item) => {
        if (clickZoomTeardowns.has(item)) return;
        const opener = item.querySelector('.product__modal-opener--image');
        const toggle = item.querySelector('.product__media-toggle');
        const image = item.querySelector('.product__media img');
        if (!opener || !image) return;

        const updateZoomOrigin = (event) => {
          if (!desktopGalleryZoomMedia.matches || !item.classList.contains('is-click-zoomed') || !image) return;
          const bounds = item.getBoundingClientRect();
          const x = ((event.clientX - bounds.left) / bounds.width) * 100;
          const y = ((event.clientY - bounds.top) / bounds.height) * 100;
          image.style.transformOrigin = `${Math.min(Math.max(x, 0), 100).toFixed(2)}% ${Math.min(Math.max(y, 0), 100).toFixed(2)}%`;
        };

        const handleClickZoom = (event) => {
          if (!desktopGalleryZoomMedia.matches) return;
          event.preventDefault();
          event.stopPropagation();
          event.stopImmediatePropagation?.();
          clickZoomItems.forEach((otherItem) => {
            if (otherItem !== item) {
              otherItem.classList.remove('is-click-zoomed');
              otherItem.querySelector('.product__media img')?.style.removeProperty('transform-origin');
            }
          });
          item.classList.toggle('is-click-zoomed');
          if (!item.classList.contains('is-click-zoomed')) {
            image?.style.removeProperty('transform-origin');
            return;
          }
          updateZoomOrigin(event);
        };

        const handleMouseLeave = () => {
          item.classList.remove('is-click-zoomed');
          image?.style.removeProperty('transform-origin');
        };

        opener.addEventListener('click', handleClickZoom, true);
        toggle?.addEventListener('click', handleClickZoom, true);
        item.addEventListener('click', handleClickZoom, true);
        item.addEventListener('mousemove', updateZoomOrigin);
        item.addEventListener('mouseleave', handleMouseLeave);

        clickZoomTeardowns.set(item, () => {
          opener.removeEventListener('click', handleClickZoom, true);
          toggle?.removeEventListener('click', handleClickZoom, true);
          item.removeEventListener('click', handleClickZoom, true);
          item.removeEventListener('mousemove', updateZoomOrigin);
          item.removeEventListener('mouseleave', handleMouseLeave);
        });
      };

      const syncGalleryZoomLayout = () => {
        if (!slider) return;
        const visibleItems = Array.from(slider.querySelectorAll('.product__media-item[data-media-id]')).filter(
          (item) => !item.classList.contains('is-product-media-filtered')
        );
        const frontItems = visibleItems.filter((item) => item.dataset.productMediaView === 'front');
        const detailItems = visibleItems.filter((item) => item.dataset.productMediaView === 'detail');
        const backItems = visibleItems.filter((item) => item.dataset.productMediaView === 'back');
        const otherItems = visibleItems.filter(
          (item) => !['front', 'detail', 'back'].includes(item.dataset.productMediaView)
        );
        const beforeBackItems = [...frontItems, ...detailItems, ...otherItems];
        const orderedVisibleItems = [
          ...beforeBackItems.slice(0, 2),
          ...backItems.slice(0, 1),
          ...beforeBackItems.slice(2),
          ...backItems.slice(1),
        ].filter(Boolean);

        slider.querySelectorAll('.product__media-item').forEach((item) => {
          item.classList.remove(
            'product__media-item--filtered-small',
            'product__media-item--filtered-large',
            'product__media-item--click-zoom',
            'product__media-item--click-zoom-large'
          );
          item.classList.remove('is-click-zoomed');
          item.querySelector('.product__media img')?.style.removeProperty('transform-origin');
          item.style.removeProperty('order');
        });

        clickZoomItems = orderedVisibleItems;
        clickZoomItems.forEach((item, index) => {
          item.classList.add('product__media-item--click-zoom');
          if (index === 2) {
            item.classList.add('product__media-item--filtered-large', 'product__media-item--click-zoom-large');
            item.style.order = '3';
          } else {
            item.classList.add('product__media-item--filtered-small');
            item.style.order = String(index + 1);
          }
          bindClickZoomItem(item);
        });
      };

      const syncGalleryToSelectedColor = () => {
        if (!slider) return;
        const selectedColor = getSelectedProductColor();
        const mediaItems = Array.from(slider.querySelectorAll('.product__media-item[data-media-id]'));
        if (!mediaItems.length) return;

        if (!selectedColor) {
          mediaItems.forEach((item) => item.classList.remove('is-product-media-filtered'));
          root?.querySelectorAll('.thumbnail-list__item[data-target]').forEach((thumbnail) => {
            thumbnail.classList.remove('is-product-media-filtered');
          });
          setGalleryProgressDotCount(mediaItems.length);
          syncGalleryZoomLayout();
          resetClickZoom();
          requestGalleryScrollUpdate();
          return;
        }

        const mediaMatches = (item) => {
          const colors = (item.dataset.productMediaColors || '')
            .split(/\s+/)
            .map(normalizeProductColor)
            .filter(Boolean);
          return colors.includes(selectedColor);
        };

        const hasMatchingMedia = mediaItems.some(mediaMatches);
        if (!hasMatchingMedia) {
          mediaItems.forEach((item) => item.classList.remove('is-product-media-filtered'));
          setGalleryProgressDotCount(mediaItems.length);
          syncGalleryZoomLayout();
          return;
        }

        mediaItems.forEach((item) => {
          item.classList.toggle('is-product-media-filtered', !mediaMatches(item));
          item.classList.remove('is-active');
        });

        const visibleItems = mediaItems.filter((item) => !item.classList.contains('is-product-media-filtered'));
        visibleItems[0]?.classList.add('is-active');
        setGalleryProgressDotCount(visibleItems.length);

        root?.querySelectorAll('.thumbnail-list__item[data-target]').forEach((thumbnail) => {
          const target = thumbnail.dataset.target;
          const mediaItem = mediaItems.find((item) => item.dataset.mediaId === target);
          thumbnail.classList.toggle('is-product-media-filtered', Boolean(mediaItem?.classList.contains('is-product-media-filtered')));
        });

        syncGalleryZoomLayout();
        if (galleryScroll) galleryScroll.scrollTop = 0;
        if (slider) {
          slider.scrollLeft = 0;
          slider.scrollTo?.({ left: 0, behavior: 'instant' });
        }
        resetClickZoom();
        requestGalleryScrollUpdate();
        window.requestAnimationFrame(() => {
          slider.dispatchEvent(new Event('scroll'));
        });
      };

      const scheduleGalleryColorSync = () => {
        syncGalleryToSelectedColor();
        window.setTimeout(syncGalleryToSelectedColor, 120);
        window.setTimeout(syncGalleryToSelectedColor, 420);
        window.setTimeout(() => slider?.dispatchEvent(new Event('scroll')), 520);
      };

      root?.addEventListener('change', (event) => {
        if (event.target?.matches('.product-form__input--color-option input[type="radio"]')) {
          scheduleGalleryColorSync();
        }
      });

      desktopGalleryZoomMedia.addEventListener?.('change', (event) => {
        if (!event.matches) resetClickZoom();
      });

      scheduleGalleryColorSync();

      if (!viewer || !slider || !dots || !dotItems.length) return;

      let frame = null;

      const updateDots = () => {
        frame = null;
        const slides = Array.from(slider.querySelectorAll('.product__media-item')).filter(
          (slide) => !slide.classList.contains('is-product-media-filtered') && slide.getBoundingClientRect().width > 0
        );
        if (slides.length < 2) return;

        const slideDistance = slider.clientWidth || slides[0].getBoundingClientRect().width || 1;
        const maxProgress = slides.length - 1;
        const progress = Math.min(Math.max(slider.scrollLeft / slideDistance, 0), maxProgress);

        dotItems.forEach((dot, index) => {
          const amount = Math.max(0, 1 - Math.abs(progress - index));
          const dotSize = 5.5;
          const lineWidth = 16.5;
          const activeWidth = dotSize + (lineWidth - dotSize) * amount;
          const lineOpacity = Math.min(amount * 4, 1);

          dot.style.setProperty('--dot-progress', amount.toFixed(3));
          dot.style.setProperty('--dot-muted-opacity', (1 - amount).toFixed(3));
          dot.style.setProperty('--dot-line-opacity', lineOpacity.toFixed(3));
          dot.style.setProperty('--dot-active-width', `${activeWidth.toFixed(2)}px`);
        });
      };

      const requestUpdate = () => {
        if (frame) return;
        frame = window.requestAnimationFrame(updateDots);
      };

      slider.addEventListener('scroll', requestUpdate, { passive: true });
      viewer.addEventListener('slideChanged', requestUpdate);
      window.addEventListener('resize', requestUpdate);
      requestUpdate();
    })();
  </script>
  <script>
    (() => {
      const storageKey = 'wog-recently-viewed-products';
      const currentProductId = Number({{ product.id | json }});
      if (!currentProductId) return;

      try {
        const parsed = JSON.parse(window.localStorage.getItem(storageKey) || '[]');
        const recentIds = Array.isArray(parsed) ? parsed.map((value) => Number(value)).filter(Boolean) : [];
        const nextIds = [currentProductId, ...recentIds.filter((productId) => productId !== currentProductId)].slice(0, 24);
        window.localStorage.setItem(storageKey, JSON.stringify(nextIds));
      } catch (error) {}
    })();
  </script>
  </div>
</product-info>

