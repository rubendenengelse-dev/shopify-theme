{%- endstyle -%}

{%- liquid
  assign products_to_display = section.settings.collection.all_products_count

  if section.settings.collection.all_products_count > section.settings.products_to_show
    assign products_to_display = section.settings.products_to_show
    assign more_in_collection = true
  endif

  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign columns_desktop_int = section.settings.columns_desktop | plus: 0
  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and products_to_display > columns_mobile_int
    assign show_mobile_slider = true
  endif

  assign max_columns_to_show = columns_mobile_int
  if columns_desktop_int > columns_mobile_int
    assign max_columns_to_show = columns_desktop_int
  endif

  assign show_desktop_slider = false
  if section.settings.enable_desktop_slider and products_to_display > section.settings.columns_desktop
    assign show_desktop_slider = true
  endif
-%}

{% if should_render_featured_collection %}
<div
  class="color-{{ section.settings.color_scheme }} isolate gradient"
>
  <div
    class="collection{% if section.settings.quick_add == 'bulk' %} collection-quick-add-bulk{% endif %} section-{{ section.id }}-padding{% if section.settings.full_width %} collection--full-width{% endif %}"
    id="collection-{{ section.id }}"
    data-id="{{ section.id }}"
    data-mobile-product-columns="2"
  >
    <div class="collection__title title-wrapper title-wrapper--no-top-margin page-width{% if show_mobile_slider %} title-wrapper--self-padded-tablet-down{% endif %}{% if show_desktop_slider %} collection__title--desktop-slider{% endif %}">
      {%- if section.settings.title != blank -%}
        <h2 class="title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          POPULAIRE BESTSELLERS
        </h2>
      {%- endif -%}
      {%- if section.settings.show_view_all and more_in_collection -%}
        <div class="collection__view-all{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          <a
            href="{{ section.settings.collection.url }}"
            class="bestsellers-view-all"
            aria-label="{{ 'sections.featured_collection.view_all_label' | t: collection_name: section.settings.collection.title | escape }}"
          >
            <span class="bestsellers-view-all-text">BEKIJK ALLES</span>
          </a>
        </div>
      {%- endif -%}
      {%- if section.settings.description != blank
        or section.settings.show_description
        and section.settings.collection.description != empty
      -%}
        <div class="collection__description {{ section.settings.description_style }} rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {%- if section.settings.show_description -%}
            {{ section.settings.collection.description }}
          {%- else -%}
            {{ section.settings.description -}}
          {%- endif %}
        </div>
      {%- endif -%}
    </div>

    {%- unless request.page_type == 'index' -%}
      <div class="mobile-product-column-toggle" aria-label="Productweergave">
        <div class="mobile-product-column-toggle__group" role="group" aria-label="Aantal kolommen">
          <button
            class="mobile-product-column-toggle__button is-active"
            type="button"
            data-mobile-product-columns="2"
            aria-label="Toon producten in 2 kolommen"
            aria-pressed="true"
          >
            <span class="mobile-product-column-toggle__icon" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
          </button>
          <button
            class="mobile-product-column-toggle__button"
            type="button"
            data-mobile-product-columns="1"
            aria-label="Toon producten in 1 kolom"
            aria-pressed="false"
          >
            <span class="mobile-product-column-toggle__icon" aria-hidden="true"><span></span></span>
          </button>
        </div>
        <button class="mobile-product-filter-sort" type="button">
          <svg class="mobile-product-filter-sort__icon" viewBox="0 0 20 20" focusable="false" aria-hidden="true">
            <path d="M3 5h14M6 10h8M8.5 15h3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          <span>Filter &amp; s...</span>
        </button>
      </div>
      <div class="mobile-filter-sort-sheet" aria-hidden="true">
        <div class="mobile-filter-sort-sheet__panel" role="dialog" aria-modal="true" aria-label="Filter en sorteren">
          <div class="mobile-filter-sort-sheet__header">
            <h3 class="mobile-filter-sort-sheet__title">Filter &amp; sorteren</h3>
            <button class="mobile-filter-sort-sheet__close" type="button" aria-label="Sluiten">
              <svg viewBox="0 0 22 22" focusable="false" aria-hidden="true">
                <path d="M6 6l10 10M16 6 6 16" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
          <div class="mobile-filter-sort-sheet__content">
            <details class="mobile-filter-sort-dropdown">
              <summary class="mobile-filter-sort-dropdown__summary">
                <span>Sorteer op</span>
                <svg viewBox="0 0 12 12" focusable="false" aria-hidden="true">
                  <path d="M4.25 2.75 7.5 6 4.25 9.25" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </summary>
              <div class="mobile-filter-sort-dropdown__body">
                <div class="mobile-filter-sort-options" data-mobile-filter-group="sort">
                  <button class="mobile-filter-sort-option mobile-filter-sort-option--radio" type="button" aria-pressed="false" data-mobile-sort-value="default">
                    <span>Relevantie</span>
                    <span class="mobile-filter-sort-option__radio" aria-hidden="true"></span>
                  </button>
                  <button class="mobile-filter-sort-option mobile-filter-sort-option--radio" type="button" aria-pressed="false" data-mobile-sort-value="newest">
                    <span>Nieuwste</span>
                    <span class="mobile-filter-sort-option__radio" aria-hidden="true"></span>
                  </button>
                </div>
              </div>
            </details>
            <details class="mobile-filter-sort-dropdown">
              <summary class="mobile-filter-sort-dropdown__summary">
                <span>Maat</span>
                <svg viewBox="0 0 12 12" focusable="false" aria-hidden="true">
                  <path d="M4.25 2.75 7.5 6 4.25 9.25" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </summary>
              <div class="mobile-filter-sort-dropdown__body">
                <div class="mobile-filter-sort-options mobile-filter-sort-options--size" data-mobile-filter-group="size">
                  <button class="mobile-filter-sort-option" type="button">XS</button>
                  <button class="mobile-filter-sort-option" type="button">S</button>
                  <button class="mobile-filter-sort-option" type="button">M</button>
                  <button class="mobile-filter-sort-option" type="button">L</button>
                  <button class="mobile-filter-sort-option" type="button">XL</button>
                  <button class="mobile-filter-sort-option" type="button">XXL</button>
                </div>
              </div>
            </details>
            <details class="mobile-filter-sort-dropdown">
              <summary class="mobile-filter-sort-dropdown__summary">
                <span>Kleur</span>
                <svg viewBox="0 0 12 12" focusable="false" aria-hidden="true">
                  <path d="M4.25 2.75 7.5 6 4.25 9.25" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </summary>
              <div class="mobile-filter-sort-dropdown__body">
                <div class="mobile-filter-sort-options mobile-filter-sort-options--color" data-mobile-filter-group="color">
                  <button class="mobile-filter-sort-color-swatch" type="button" aria-label="Black" data-mobile-filter-color="black">
                    <span class="mobile-filter-sort-color-swatch__dot mobile-filter-sort-color-swatch__dot--black" aria-hidden="true"></span>
                  </button>
                  <button class="mobile-filter-sort-color-swatch" type="button" aria-label="White" data-mobile-filter-color="white">
                    <span class="mobile-filter-sort-color-swatch__dot mobile-filter-sort-color-swatch__dot--white" aria-hidden="true"></span>
                  </button>
                </div>
              </div>
            </details>
            <button class="mobile-filter-sort-clear" type="button" data-mobile-filter-clear>
              Alles wissen
            </button>
          </div>
        </div>
      </div>
    {%- endunless -%}

    {%- unless request.page_type == 'index' -%}
      <div class="desktop-filter-layout">
        <aside class="desktop-filter-sidebar" aria-label="Filter en sorteren">
          <p class="desktop-filter-sidebar__title">Filter &amp; sorteren</p>
          <details class="mobile-filter-sort-dropdown">
            <summary class="mobile-filter-sort-dropdown__summary">
              <span>Sorteer op</span>
              <svg viewBox="0 0 12 12" focusable="false" aria-hidden="true">
                <path d="M4.25 2.75 7.5 6 4.25 9.25" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <div class="mobile-filter-sort-dropdown__body">
              <div class="mobile-filter-sort-options" data-mobile-filter-group="sort">
                <button class="mobile-filter-sort-option mobile-filter-sort-option--radio" type="button" aria-pressed="false" data-mobile-sort-value="default">
                  <span>Relevantie</span>
                  <span class="mobile-filter-sort-option__radio" aria-hidden="true"></span>
                </button>
                <button class="mobile-filter-sort-option mobile-filter-sort-option--radio" type="button" aria-pressed="false" data-mobile-sort-value="newest">
                  <span>Nieuwste</span>
                  <span class="mobile-filter-sort-option__radio" aria-hidden="true"></span>
                </button>
              </div>
            </div>
          </details>
          <details class="mobile-filter-sort-dropdown">
            <summary class="mobile-filter-sort-dropdown__summary">
              <span>Maat</span>
              <svg viewBox="0 0 12 12" focusable="false" aria-hidden="true">
                <path d="M4.25 2.75 7.5 6 4.25 9.25" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <div class="mobile-filter-sort-dropdown__body">
              <div class="mobile-filter-sort-options mobile-filter-sort-options--size" data-mobile-filter-group="size">
                <button class="mobile-filter-sort-option" type="button">XS</button>
                <button class="mobile-filter-sort-option" type="button">S</button>
                <button class="mobile-filter-sort-option" type="button">M</button>
                <button class="mobile-filter-sort-option" type="button">L</button>
                <button class="mobile-filter-sort-option" type="button">XL</button>
                <button class="mobile-filter-sort-option" type="button">XXL</button>
              </div>
            </div>
          </details>
          <details class="mobile-filter-sort-dropdown">
            <summary class="mobile-filter-sort-dropdown__summary">
              <span>Kleur</span>
              <svg viewBox="0 0 12 12" focusable="false" aria-hidden="true">
                <path d="M4.25 2.75 7.5 6 4.25 9.25" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <div class="mobile-filter-sort-dropdown__body">
              <div class="mobile-filter-sort-options mobile-filter-sort-options--color" data-mobile-filter-group="color">
                <button class="mobile-filter-sort-color-swatch" type="button" aria-label="Black" data-mobile-filter-color="black">
                  <span class="mobile-filter-sort-color-swatch__dot mobile-filter-sort-color-swatch__dot--black" aria-hidden="true"></span>
                </button>
                <button class="mobile-filter-sort-color-swatch" type="button" aria-label="White" data-mobile-filter-color="white">
                  <span class="mobile-filter-sort-color-swatch__dot mobile-filter-sort-color-swatch__dot--white" aria-hidden="true"></span>
                </button>
              </div>
            </div>
          </details>
          <button class="mobile-filter-sort-clear" type="button" data-mobile-filter-clear>
            Alles wissen
          </button>
        </aside>
    {%- endunless -%}

    <slider-component class="slider-mobile-gutter{% if section.settings.full_width %} slider-component-full-width{% endif %}{% if show_mobile_slider == false %} page-width{% endif %}{% if show_desktop_slider == false and section.settings.full_width == false %} page-width-desktop{% endif %}{% if show_desktop_slider %} slider-component-desktop{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"{% if request.page_type == 'index' %} data-wog-laptop-smooth-slider{% endif %}>
      <ul
        id="Slider-{{ section.id }}"
        data-id="{{ section.id }}"
        class="grid product-grid contains-card contains-card--product{% if settings.card_style == 'standard' %} contains-card--standard{% endif %} grid--{{ section.settings.columns_desktop }}-col-desktop{% if section.settings.collection == blank %} grid--2-col-tablet-down{% else %} grid--{{ section.settings.columns_mobile }}-col-tablet-down{% endif %}{% if show_mobile_slider or show_desktop_slider %} slider{% if show_desktop_slider %} slider--desktop{% endif %}{% if show_mobile_slider %} slider--tablet grid--peek{% endif %}{% endif %}"
        role="list"
        aria-label="{{ 'general.slider.name' | t }}"
      >
        {% assign skip_card_product_styles = false %}

        {%- if section.settings.collection.products.size > 0 -%}
          {% assign lazy_load = false %}
          {% paginate section.settings.collection.products by section.settings.products_to_show %}
            {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
              {% if lazy_load == false and forloop.index > max_columns_to_show %}
                {% assign lazy_load = true %}
              {% endif %}
              {%- liquid
                assign wog_black_media = blank
                assign wog_white_media = blank
                assign wog_has_black_variant = false
                assign wog_has_white_variant = false
                for media in product.media
                  assign media_alt_downcase = media.alt | downcase
                  if wog_black_media == blank
                    if media_alt_downcase contains 'black' or media_alt_downcase contains 'zwart'
                      assign wog_black_media = media.preview_image
                    endif
                  endif
                  if wog_white_media == blank
                    if media_alt_downcase contains 'white' or media_alt_downcase contains 'wit'
                      assign wog_white_media = media.preview_image
                    endif
                  endif
                endfor
                for option in product.options_with_values
                  for value in option.values
                    assign value_downcase = value | downcase
                    if value_downcase contains 'black' or value_downcase contains 'zwart'
                      assign wog_has_black_variant = true
                    endif
                    if value_downcase contains 'white' or value_downcase contains 'wit'
                      assign wog_has_white_variant = true
                    endif
                  endfor
                endfor
                if wog_has_black_variant and wog_black_media == blank
                  assign wog_black_media = product.featured_image
                endif
                if wog_has_white_variant and wog_white_media == blank
                  assign wog_white_media = product.featured_image
                endif
              -%}
              <li
                id="Slide-{{ section.id }}-{{ forloop.index }}"
                class="grid__item{% if show_mobile_slider or show_desktop_slider %} slider__slide{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                data-sort-default-order="{{ forloop.index0 }}"
                data-sort-newest="{{ product.published_at | default: product.created_at | date: '%s' }}"
                data-product-id="{{ product.id }}"
                {% if wog_black_media != blank %}
                  data-wog-color-black-src="{{ wog_black_media | image_url: width: 720 }}"
                  data-wog-color-black-srcset="{%- if wog_black_media.width >= 360 -%}{{ wog_black_media | image_url: width: 360 }} 360w,{%- endif -%}{%- if wog_black_media.width >= 533 -%}{{ wog_black_media | image_url: width: 533 }} 533w,{%- endif -%}{%- if wog_black_media.width >= 720 -%}{{ wog_black_media | image_url: width: 720 }} 720w,{%- endif -%}{{ wog_black_media | image_url }} {{ wog_black_media.width }}w"
                {% endif %}
                {% if wog_white_media != blank %}
                  data-wog-color-white-src="{{ wog_white_media | image_url: width: 720 }}"
                  data-wog-color-white-srcset="{%- if wog_white_media.width >= 360 -%}{{ wog_white_media | image_url: width: 360 }} 360w,{%- endif -%}{%- if wog_white_media.width >= 533 -%}{{ wog_white_media | image_url: width: 533 }} 533w,{%- endif -%}{%- if wog_white_media.width >= 720 -%}{{ wog_white_media | image_url: width: 720 }} 720w,{%- endif -%}{{ wog_white_media | image_url }} {{ wog_white_media.width }}w"
                {% endif %}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: section.settings.image_ratio,
                  image_shape: section.settings.image_shape,
                  lazy_load: lazy_load,
                  show_secondary_image: section.settings.show_secondary_image,
                  show_vendor: section.settings.show_vendor,
                  show_rating: section.settings.show_rating,
                  skip_styles: skip_card_product_styles,
                  section_id: section.id,
                  quick_add: section.settings.quick_add,
                  remove_currency_code: true
                %}
              </li>
              {%- assign skip_card_product_styles = true -%}
            {%- endfor -%}
          {% endpaginate %}
        {%- else -%}
          {%- for i in (1..section.settings.columns_desktop) -%}
            <li
              class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              {% liquid
                assign ridx = forloop.rindex
                case ridx
                  when 5
                    assign ridx = 1
                  when 6
                    assign ridx = 2
                endcase
              %}
              {%- assign placeholder_image = 'product-apparel-' | append: ridx -%}
              {% render 'card-product',
                show_vendor: section.settings.show_vendor,
                media_aspect_ratio: section.settings.image_ratio,
                image_shape: section.settings.image_shape,
                lazy_load: false,
                placeholder_image: placeholder_image,
                remove_currency_code: true
              %}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
      {%- if show_mobile_slider or show_desktop_slider -%}
        <div class="slider-buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ products_to_display }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>
    {% if section.settings.image_shape == 'arch' %}
      {{ 'mask-arch.svg' | inline_asset_content }}
    {%- endif -%}
    {%- unless request.page_type == 'index' -%}
      </div>
    {%- endunless -%}
  </div>
</div>

<script>
  (() => {
    if (window.__wogLaptopHomepageSliderFix) return;
    window.__wogLaptopHomepageSliderFix = true;

    const laptopQuery = window.matchMedia('(min-width: 990px) and (max-width: 1399px) and (hover: hover) and (pointer: fine)');

    const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);

    const animateSlider = (slider, targetLeft) => {
      const slides = Array.from(slider.querySelectorAll('.slider__slide'));
      if (!slides.length) {
        slider.scrollLeft = targetLeft;
        return;
      }

      const startLeft = slider.scrollLeft;
      const distance = targetLeft - startLeft;
      if (Math.abs(distance) < 1) return;

      const previousSnapType = slider.style.scrollSnapType;
      const previousScrollBehavior = slider.style.scrollBehavior;
      const duration = 360;
      const startTime = performance.now();

      slider.style.scrollSnapType = 'none';
      slider.style.scrollBehavior = 'auto';

      slides.forEach((slide) => {
        slide.style.willChange = 'transform';
      });

      const step = (currentTime) => {
        const progress = Math.min((currentTime - startTime) / duration, 1);
        const eased = easeOutCubic(progress);
        const translateX = -distance * eased;

        slides.forEach((slide) => {
          slide.style.transform = `translateX(${translateX}px)`;
        });

        if (progress < 1) {
          window.requestAnimationFrame(step);
          return;
        }

        slider.scrollLeft = targetLeft;

        slides.forEach((slide) => {
          slide.style.transform = '';
          slide.style.willChange = '';
        });

        slider.style.scrollSnapType = previousSnapType;
        slider.style.scrollBehavior = previousScrollBehavior;
      };

      window.requestAnimationFrame(step);
    };

    const bindSliderComponent = (sliderComponent) => {
      if (!sliderComponent || sliderComponent.dataset.wogLaptopSliderBound === 'true') return;

      const slider = sliderComponent.querySelector('[id^="Slider-"]');
      const previousButton = sliderComponent.querySelector('button[name="previous"]');
      const nextButton = sliderComponent.querySelector('button[name="next"]');
      if (!slider || !previousButton || !nextButton) return;

      const replaceButton = (button) => {
        const clone = button.cloneNode(true);
        button.replaceWith(clone);
        return clone;
      };

      const previousClone = replaceButton(previousButton);
      const nextClone = replaceButton(nextButton);

      const handleClick = (event) => {
        if (!laptopQuery.matches) return;

        const button = event.currentTarget;
        const slides = Array.from(slider.querySelectorAll('.slider__slide')).filter((slide) => slide.clientWidth > 0);
        if (slides.length < 2) return;

        const pageScrollY = window.scrollY;
        const itemOffset = slides[1].offsetLeft - slides[0].offsetLeft;
        const step = Number(button.dataset.step || 1);
        const rawTarget =
          button.name === 'next' ? slider.scrollLeft + step * itemOffset : slider.scrollLeft - step * itemOffset;
        const maxScroll = Math.max(0, slider.scrollWidth - slider.clientWidth);
        const targetLeft = Math.max(0, Math.min(rawTarget, maxScroll));

        event.preventDefault();
        animateSlider(slider, targetLeft);

        window.setTimeout(() => {
          slider.dispatchEvent(new Event('scroll'));
          if (window.scrollY !== pageScrollY) {
            window.scrollTo({ top: pageScrollY, left: window.scrollX, behavior: 'auto' });
          }
        }, 380);
      };

      previousClone.addEventListener('click', handleClick);
      nextClone.addEventListener('click', handleClick);
      sliderComponent.dataset.wogLaptopSliderBound = 'true';
    };

    const bindAll = () => {
      document.querySelectorAll('[data-wog-laptop-smooth-slider]').forEach(bindSliderComponent);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindAll, { once: true });
    } else {
      bindAll();
    }
  })();

  (() => {
    const collection = document.getElementById('collection-{{ section.id }}');
    if (!collection) return;

    const buttons = Array.from(collection.querySelectorAll('.mobile-product-column-toggle__button'));
    if (!buttons.length) return;
    const filterSortButton = collection.querySelector('.mobile-product-filter-sort');
    const filterSortSheet = collection.querySelector('.mobile-filter-sort-sheet');
    const filterSortRoots = Array.from(collection.querySelectorAll('.mobile-filter-sort-sheet, .desktop-filter-sidebar'));
    const productGrid = collection.querySelector('.product-grid');
    const productItems = Array.from(collection.querySelectorAll('.product-grid .grid__item'));
    const recentlyViewedStorageKey = 'wog-recently-viewed-products';

    const storageKey = 'wog-mobile-product-columns';
    const setColumns = (columns) => {
      const nextColumns = columns === '1' ? '1' : '2';
      collection.dataset.mobileProductColumns = nextColumns;
      buttons.forEach((button) => {
        const isActive = button.dataset.mobileProductColumns === nextColumns;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-pressed', String(isActive));
      });
      try {
        window.localStorage.setItem(storageKey, nextColumns);
      } catch (error) {}
    };

    try {
      setColumns(window.localStorage.getItem(storageKey) || '2');
    } catch (error) {
      setColumns('2');
    }

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        setColumns(button.dataset.mobileProductColumns);
      });
    });

    if (filterSortButton && filterSortSheet) {
      const openFilterSort = () => {
        filterSortSheet.classList.add('is-open');
        filterSortSheet.setAttribute('aria-hidden', 'false');
        document.documentElement.classList.add('mobile-filter-sort-open');
      };

      const closeFilterSort = () => {
        filterSortSheet.classList.remove('is-open');
        filterSortSheet.setAttribute('aria-hidden', 'true');
        document.documentElement.classList.remove('mobile-filter-sort-open');
      };

      filterSortButton.addEventListener('click', openFilterSort);
      filterSortSheet.addEventListener('click', (event) => {
        if (event.target === filterSortSheet || event.target.closest('.mobile-filter-sort-sheet__close')) closeFilterSort();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeFilterSort();
      });
    }

    filterSortRoots.forEach((filterRoot) => {
      filterRoot.querySelectorAll('.mobile-filter-sort-dropdown').forEach((dropdown) => {
        dropdown.addEventListener('toggle', () => {
          if (!dropdown.open) return;
          filterRoot.querySelectorAll('.mobile-filter-sort-dropdown[open]').forEach((openDropdown) => {
            if (openDropdown !== dropdown) openDropdown.open = false;
          });
        });
      });
      filterRoot.querySelectorAll('[data-mobile-filter-group]').forEach((group) => {
        group.addEventListener('click', (event) => {
          const option = event.target.closest('.mobile-filter-sort-option, .mobile-filter-sort-color-swatch');
          if (!option || !group.contains(option)) return;

          if (group.dataset.mobileFilterGroup === 'size') {
            option.classList.toggle('is-selected');
            option.setAttribute('aria-pressed', String(option.classList.contains('is-selected')));
            return;
          }

          group.querySelectorAll('.mobile-filter-sort-option, .mobile-filter-sort-color-swatch').forEach((button) => {
            const isSelected = button === option;
            button.classList.toggle('is-selected', isSelected);
            button.setAttribute('aria-pressed', String(isSelected));
          });

          if (group.dataset.mobileFilterGroup === 'sort') {
            sortProductItems(option.dataset.mobileSortValue || 'default');
            return;
          }

          if (group.dataset.mobileFilterGroup === 'color') {
            applyColorFilter(option.dataset.mobileFilterColor || '');
          }
        });
      });
      filterRoot.querySelector('[data-mobile-filter-clear]')?.addEventListener('click', () => {
        filterRoot.querySelectorAll('[data-mobile-filter-group="sort"] .mobile-filter-sort-option').forEach((button) => {
          button.classList.remove('is-selected');
          button.setAttribute('aria-pressed', 'false');
        });
        filterRoot.querySelectorAll('[data-mobile-filter-group="size"] .mobile-filter-sort-option').forEach((button) => {
          button.classList.remove('is-selected');
          button.setAttribute('aria-pressed', 'false');
        });
        filterRoot.querySelectorAll('[data-mobile-filter-group="color"] .mobile-filter-sort-color-swatch').forEach((button) => {
          button.classList.remove('is-selected');
          button.setAttribute('aria-pressed', 'false');
        });
        sortProductItems('default');
        applyColorFilter('');
        if (filterRoot.classList.contains('mobile-filter-sort-sheet')) {
          filterRoot.classList.remove('is-open');
          filterRoot.setAttribute('aria-hidden', 'true');
          document.documentElement.classList.remove('mobile-filter-sort-open');
        }
      });
    });

    const rememberCardImage = (image) => {
      if (!image || image.dataset.wogOriginalSrc) return;
      image.dataset.wogOriginalSrc = image.getAttribute('src') || '';
      image.dataset.wogOriginalSrcset = image.getAttribute('srcset') || '';
    };

    const setCardImage = (image, src, srcset) => {
      if (!image || !src) return;
      image.setAttribute('src', src);
      if (srcset) image.setAttribute('srcset', srcset);
    };

    const restoreCardImage = (image) => {
      if (!image || !image.dataset.wogOriginalSrc) return;
      image.setAttribute('src', image.dataset.wogOriginalSrc);
      if (image.dataset.wogOriginalSrcset) image.setAttribute('srcset', image.dataset.wogOriginalSrcset);
    };

    const applyColorFilter = (color) => {
      const colorKey = color === 'white' || color === 'black' ? color : '';
      productItems.forEach((item) => {
        const image = item.querySelector('.card__media img.motion-reduce');
        rememberCardImage(image);

        if (!colorKey) {
          item.classList.remove('is-filter-hidden');
          restoreCardImage(image);
          return;
        }

        const nextSrc = item.dataset[`wogColor${colorKey.charAt(0).toUpperCase()}${colorKey.slice(1)}Src`];
        const nextSrcset = item.dataset[`wogColor${colorKey.charAt(0).toUpperCase()}${colorKey.slice(1)}Srcset`];
        item.classList.toggle('is-filter-hidden', !nextSrc);
        if (nextSrc) setCardImage(image, nextSrc, nextSrcset);
      });
    };

    const getRecentlyViewedProductIds = () => {
      try {
        const parsed = JSON.parse(window.localStorage.getItem(recentlyViewedStorageKey) || '[]');
        return Array.isArray(parsed) ? parsed.map((value) => Number(value)).filter(Boolean) : [];
      } catch (error) {
        return [];
      }
    };

    const sortProductItems = (sortValue) => {
      if (!productGrid) return;
      const recentlyViewedProductIds = getRecentlyViewedProductIds();
      const recentRank = new Map(
        recentlyViewedProductIds.map((productId, index) => [productId, recentlyViewedProductIds.length - index])
      );

      const sortedItems = [...productItems].sort((leftItem, rightItem) => {
        if (sortValue === 'newest') {
          const leftNewest = Number(leftItem.dataset.sortNewest || 0);
          const rightNewest = Number(rightItem.dataset.sortNewest || 0);

          if (leftNewest !== rightNewest) return rightNewest - leftNewest;
        }

        if (sortValue === 'default') {
          const leftRecentScore = recentRank.get(Number(leftItem.dataset.productId || 0)) || 0;
          const rightRecentScore = recentRank.get(Number(rightItem.dataset.productId || 0)) || 0;

          if (leftRecentScore !== rightRecentScore) return rightRecentScore - leftRecentScore;
        }

        return Number(leftItem.dataset.sortDefaultOrder || 0) - Number(rightItem.dataset.sortDefaultOrder || 0);
      });

      sortedItems.forEach((item) => productGrid.appendChild(item));
    };
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "t:sections.featured-collection.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "render_only_collection_handle",
      "label": "Render only on collection handle",
      "info": "Optional. Leave blank to show everywhere."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured-collection.settings.collection.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 25,
      "step": 1,
      "default": 4,
      "label": "t:sections.featured-collection.settings.products_to_show.label"
    },     
    {
      "type": "header",
      "content": "t:sections.featured-collection.settings.header_text.content"
    },   
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "t:sections.featured-collection.settings.title.default",
      "label": "t:sections.featured-collection.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.featured-collection.settings.description.label"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:sections.featured-collection.settings.show_description.label",
      "default": false   
    },
    {
      "type": "select",
      "id": "description_style",
      "label": "t:sections.featured-collection.settings.description_style.label",
      "options": [
