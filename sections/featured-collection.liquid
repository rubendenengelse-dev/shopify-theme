{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{%- assign render_only_collection_handle = section.settings.render_only_collection_handle | strip -%}
{%- assign should_render_featured_collection = true -%}
{%- if render_only_collection_handle != blank -%}
  {%- if request.page_type != 'collection' or collection.handle != render_only_collection_handle -%}
    {%- assign should_render_featured_collection = false -%}
  {%- endif -%}
{%- endif -%}
{%- assign is_collection_tshirts_vrouwen = false -%}
{%- if request.page_type == 'collection' and collection.handle == 't-shirts-vrouwen' and render_only_collection_handle == 't-shirts-vrouwen' -%}
  {%- assign is_collection_tshirts_vrouwen = true -%}
{%- endif -%}
{%- assign is_tshirts_template = false -%}
{%- if template.suffix == 't-shirts' or template.suffix == 't-shirts-man' or template.suffix == 't-shirts-vrouw' or template.suffix == 'dames-t-shirts' or template.suffix == 't-shirts-dames' or template.suffix == 't-shirt-mannen' -%}
  {%- assign is_tshirts_template = true -%}
{%- endif -%}
{%- assign is_hoodies_template = false -%}
{%- if template.suffix == 'hoodies' or template.suffix == 'hoodies-man' or template.suffix == 'hoodies-vrouw' or template.suffix == 'vrouwen-hoodie' or template.suffix == 'hoodies-vrouwen' -%}
  {%- assign is_hoodies_template = true -%}
{%- endif -%}
{%- assign is_oversize_tshirts_template = false -%}
{%- if template.suffix == 'oversize-t-shirt-s' -%}
  {%- assign is_oversize_tshirts_template = true -%}
{%- endif -%}
{%- assign is_tshirts_like_featured_collection = false -%}
{%- if is_tshirts_template or is_oversize_tshirts_template or is_hoodies_template or is_collection_tshirts_vrouwen -%}
  {%- assign is_tshirts_like_featured_collection = true -%}
{%- endif -%}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #collection-{{ section.id }} .collection__title .title,
  #collection-{{ section.id }} h2.title,
  #collection-{{ section.id }} .title.inline-richtext,
  #collection-{{ section.id }} .inline-richtext,
  #collection-{{ section.id }} .collection__title .title *,
  #collection-{{ section.id }} .collection__description,
  #collection-{{ section.id }} .collection__description *,
  #collection-{{ section.id }} .card__heading,
  #collection-{{ section.id }} .card__information,
  #collection-{{ section.id }} .card-information,
  #collection-{{ section.id }} .card-information__text,
  #collection-{{ section.id }} .card__heading *,
  #collection-{{ section.id }} .price,
  #collection-{{ section.id }} .price * {
    font-family: var(--font-body-family) !important;
    font-style: var(--font-body-style) !important;
    font-weight: var(--font-body-weight) !important;
  }

  #collection-{{ section.id }} .card__heading,
  #collection-{{ section.id }} .card__heading a,
  #collection-{{ section.id }} .card-information,
  #collection-{{ section.id }} .card-information__text,
  #collection-{{ section.id }} .price,
  #collection-{{ section.id }} .price * {
    color: #000 !important;
  }

  #collection-{{ section.id }} .price,
  #collection-{{ section.id }} .price * {
    font-weight: 600 !important;
  }

  #collection-{{ section.id }} .price__prefix,
  #collection-{{ section.id }} .price-item__label,
  #collection-{{ section.id }} .price .currency,
  #collection-{{ section.id }} .price .currency-code,
  #collection-{{ section.id }} .price .price__suffix,
  #collection-{{ section.id }} .price .price-item__label,
  #collection-{{ section.id }} .price .price__regular .visually-hidden,
  #collection-{{ section.id }} .price .price__sale .visually-hidden,
  #collection-{{ section.id }} .price .price-item .visually-hidden {
    display: none !important;
  }

  #collection-{{ section.id }} .collection__title .title,
  #collection-{{ section.id }} h2.title,
  #collection-{{ section.id }} .title.inline-richtext {
    font-weight: 700 !important;
  }

  #collection-{{ section.id }} .collection__view-all .bestsellers-view-all,
  #collection-{{ section.id }} .collection__view-all .bestsellers-view-all:visited {
    color: #000 !important;
    font-weight: 700 !important;
  }

  #collection-{{ section.id }} .collection__title {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.6rem;
    flex-wrap: wrap;
  }

  #collection-{{ section.id }} .collection__title .title {
    margin: 0;
    text-align: left !important;
    align-self: flex-start;
    margin-right: auto;
    padding-top: 0.9rem !important;
  }

  #collection-{{ section.id }} .collection__description {
    flex-basis: 100%;
  }

  #collection-{{ section.id }} .collection__title .collection__view-all {
    margin: 0 14rem 0 auto;
    text-align: right;
    align-self: flex-start;
  }

  {%- if request.page_type == 'index' -%}
    #collection-{{ section.id }} .collection__title .collection__view-all {
      display: none !important;
    }
  {%- endif -%}

  #collection-{{ section.id }} a,
  #collection-{{ section.id }} a:hover,
  #collection-{{ section.id }} a:focus,
  #collection-{{ section.id }} a:focus-visible {
    text-decoration: none !important;
    text-underline-offset: 0 !important;
    text-decoration-thickness: 0 !important;
    box-shadow: none !important;
  }

  #collection-{{ section.id }} .bestsellers-view-all,
  #collection-{{ section.id }} .bestsellers-view-all:hover,
  #collection-{{ section.id }} .bestsellers-view-all:focus,
  #collection-{{ section.id }} .bestsellers-view-all:focus-visible,
  #collection-{{ section.id }} .bestsellers-view-all:active {
    border: 0 !important;
    outline: 0 !important;
    box-shadow: none !important;
    background: transparent !important;
  }

  #collection-{{ section.id }} .grid__item.is-filter-hidden {
    display: none !important;
  }

  @media screen and (max-width: 749px) {
    #collection-{{ section.id }} a,
    #collection-{{ section.id }} button,
    #collection-{{ section.id }} .button,
    #collection-{{ section.id }} .card__heading a,
    #collection-{{ section.id }} .quick-add__submit,
    #collection-{{ section.id }} .slider-button,
    #collection-{{ section.id }} .full-unstyled-link,
    #collection-{{ section.id }} .card-wrapper,
    #collection-{{ section.id }} .card-wrapper * {
      -webkit-tap-highlight-color: transparent !important;
    }

    #collection-{{ section.id }} a:focus,
    #collection-{{ section.id }} a:focus-visible,
    #collection-{{ section.id }} button:focus,
    #collection-{{ section.id }} button:focus-visible,
    #collection-{{ section.id }} .button:focus,
    #collection-{{ section.id }} .button:focus-visible,
    #collection-{{ section.id }} .quick-add__submit:focus,
    #collection-{{ section.id }} .quick-add__submit:focus-visible,
    #collection-{{ section.id }} .slider-button:focus,
    #collection-{{ section.id }} .slider-button:focus-visible,
    #collection-{{ section.id }} .full-unstyled-link:focus,
    #collection-{{ section.id }} .full-unstyled-link:focus-visible {
      outline: none !important;
      box-shadow: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }}-padding {
      margin-top: 0 !important;
    }

    #collection-{{ section.id }} .collection__title .title,
    #collection-{{ section.id }} h2.title,
    #collection-{{ section.id }} .title.inline-richtext {
      font-size: 1.8rem !important;
      line-height: 1.15 !important;
      padding-top: 1.2rem !important;
    }

    #collection-{{ section.id }} .collection__title .collection__view-all {
      margin: 0 0 0 auto;
      transform: translateX(1.6rem);
    }

    #collection-{{ section.id }} .collection__view-all .bestsellers-view-all,
    #collection-{{ section.id }} .collection__view-all .bestsellers-view-all-text {
      font-size: 1.15rem !important;
      line-height: 1.15 !important;
    }

    #collection-{{ section.id }} .collection__view-all .bestsellers-view-all {
      display: inline-block !important;
      margin-top: calc(1.8rem + 5px) !important;
      transform: translateY(calc(-0.4rem - 5px));
    }

    #collection-{{ section.id }} .collection__view-all .bestsellers-view-all-text {
      padding-bottom: 0.35rem !important;
      background-image: linear-gradient(currentColor, currentColor) !important;
      background-repeat: no-repeat !important;
      background-position: left calc(100% - 0.02rem) !important;
      background-size: 100% 1px !important;
      transition: none !important;
    }

    #collection-{{ section.id }} .slider-buttons {
      display: none !important;
    }

    #collection-{{ section.id }} .desktop-filter-sidebar {
      display: none !important;
    }

    #collection-{{ section.id }} .mobile-product-column-toggle {
      align-items: center;
      display: flex;
      gap: 0.9rem;
      justify-content: flex-start;
      margin: 0.6rem auto 1.4rem;
      width: calc(100% - 3.2rem);
    }

    #collection-{{ section.id }} .mobile-product-column-toggle__group {
      align-items: center;
      background: #f4f4f4;
      border: 0.1rem solid rgba(0, 0, 0, 0.1);
      border-radius: 999px;
      display: inline-flex;
      flex: 0 0 16.34rem;
      gap: 0.36rem;
      height: 5.19rem;
      padding: 0.42rem;
    }

    #collection-{{ section.id }} .mobile-product-filter-sort {
      align-items: center;
      appearance: none;
      background: #f4f4f4;
      border: 0.1rem solid rgba(0, 0, 0, 0.1);
      border-radius: 999px;
      color: #000;
      display: inline-flex;
      flex: 0 0 16.34rem;
      font-family: var(--font-heading-family);
      font-size: 1.52rem;
      font-weight: 760;
      gap: 0.75rem;
      height: 5.19rem;
      justify-content: center;
      letter-spacing: 0;
      line-height: 1;
      padding: 0 1.4rem;
      text-transform: uppercase;
      -webkit-tap-highlight-color: transparent !important;
    }

    #collection-{{ section.id }} .mobile-product-filter-sort__icon {
      display: block;
      height: 1.8rem;
      width: 1.8rem;
    }

    #collection-{{ section.id }} .mobile-product-filter-sort:focus,
    #collection-{{ section.id }} .mobile-product-filter-sort:focus-visible,
    #collection-{{ section.id }} .mobile-product-filter-sort:active {
      box-shadow: none !important;
      outline: none !important;
    }

    #collection-{{ section.id }} .mobile-filter-sort-sheet {
      background: rgba(0, 0, 0, 0.34);
      bottom: 0;
      left: 0;
      opacity: 0;
      pointer-events: none;
      position: fixed;
      right: 0;
      top: 0;
      transition: opacity 220ms ease;
      z-index: 80;
    }

    #collection-{{ section.id }} .mobile-filter-sort-sheet.is-open {
      opacity: 1;
      pointer-events: auto;
    }

    #collection-{{ section.id }} .mobile-filter-sort-sheet__panel {
      background: #fff;
      border-radius: 0;
      bottom: 0;
      left: 0;
      min-height: 74vh;
      padding: 0 2rem 2.8rem;
      position: absolute;
      right: 0;
      transform: translateY(100%);
      transition: transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    #collection-{{ section.id }} .mobile-filter-sort-sheet.is-open .mobile-filter-sort-sheet__panel {
      transform: translateY(0);
    }

    #collection-{{ section.id }} .mobile-filter-sort-sheet__header {
      align-items: center;
      border-bottom: 0.1rem solid rgba(0, 0, 0, 0.11);
      display: flex;
      justify-content: center;
      min-height: 6.4rem;
      position: relative;
    }

    #collection-{{ section.id }} .mobile-filter-sort-sheet__title {
      color: #000;
      font-family: var(--font-heading-family);
      font-size: 1.86rem;
      font-weight: 700;
      letter-spacing: 0;
      line-height: 1.1;
      margin: 0;
      text-transform: uppercase;
    }

    #collection-{{ section.id }} .mobile-filter-sort-sheet__close {
      align-items: center;
      appearance: none;
      background: transparent;
      border: 0;
      color: #000;
      display: inline-flex;
      height: 4.4rem;
      justify-content: center;
      padding: 0;
      position: absolute;
      right: -0.4rem;
      top: 50%;
      transform: translateY(-50%);
      width: 4.4rem;
      -webkit-tap-highlight-color: transparent !important;
    }

    #collection-{{ section.id }} .mobile-filter-sort-sheet__close svg {
      display: block;
      height: 2.45rem;
      width: 2.45rem;
    }

    #collection-{{ section.id }} .mobile-filter-sort-sheet__close:focus,
    #collection-{{ section.id }} .mobile-filter-sort-sheet__close:focus-visible,
    #collection-{{ section.id }} .mobile-filter-sort-sheet__close:active {
      box-shadow: none !important;
      outline: none !important;
    }

    #collection-{{ section.id }} .mobile-filter-sort-sheet__content {
      display: flex;
      flex-direction: column;
      padding-top: 1.6rem;
    }

    #collection-{{ section.id }} .mobile-filter-sort-dropdown {
      border-bottom: 0.1rem solid rgba(0, 0, 0, 0.1);
    }

    #collection-{{ section.id }} .mobile-filter-sort-dropdown__summary {
      align-items: center;
      color: #000;
      cursor: pointer;
      display: flex;
      font-family: var(--font-heading-family);
      font-size: 1.62rem;
      font-weight: 680;
      justify-content: space-between;
      letter-spacing: 0;
      line-height: 1;
      list-style: none;
      padding: 1.85rem 0;
      text-transform: uppercase;
      -webkit-tap-highlight-color: transparent !important;
    }

    #collection-{{ section.id }} .mobile-filter-sort-dropdown__summary::-webkit-details-marker {
      display: none;
    }

    #collection-{{ section.id }} .mobile-filter-sort-dropdown__summary svg {
      display: block;
      height: 1.35rem;
      transform: rotate(90deg);
      transition: transform 180ms ease;
      width: 1.35rem;
    }

    #collection-{{ section.id }} .mobile-filter-sort-dropdown[open] .mobile-filter-sort-dropdown__summary svg {
      transform: rotate(-90deg);
    }

    #collection-{{ section.id }} .mobile-filter-sort-dropdown__body {
      color: rgba(0, 0, 0, 0.55);
      font-size: 1.32rem;
      font-weight: 360;
      padding: 0.1rem 0 1.7rem;
    }

    #collection-{{ section.id }} .mobile-filter-sort-options {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    #collection-{{ section.id }} .mobile-filter-sort-option {
      appearance: none;
      background: transparent;
      border: 0;
      color: rgba(0, 0, 0, 0.66);
      display: flex;
      font-family: var(--font-body-family);
      font-size: 1.54rem;
      font-weight: 460;
      justify-content: flex-start;
      letter-spacing: 0;
      line-height: 1.2;
      padding: 0.86rem 0;
      text-align: left;
      text-transform: none;
      -webkit-tap-highlight-color: transparent !important;
    }

    #collection-{{ section.id }} .mobile-filter-sort-option:focus,
    #collection-{{ section.id }} .mobile-filter-sort-option:focus-visible,
    #collection-{{ section.id }} .mobile-filter-sort-option:active {
      box-shadow: none !important;
      outline: none !important;
    }

    #collection-{{ section.id }} .mobile-filter-sort-options--size {
      display: grid;
      gap: 0.8rem;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    #collection-{{ section.id }} .mobile-filter-sort-options--size .mobile-filter-sort-option {
      align-items: center;
      border: 0.1rem solid rgba(0, 0, 0, 0.16);
      color: #000;
      font-family: var(--font-heading-family);
      font-size: 1.42rem;
      font-weight: 680;
      height: 4.45rem;
      justify-content: center;
      padding: 0;
      text-align: center;
      text-transform: uppercase;
    }

    #collection-{{ section.id }} .mobile-filter-sort-option.is-selected {
      border-color: #000;
    }

    #collection-{{ section.id }} .mobile-filter-sort-option--radio {
      align-items: center;
      gap: 1rem;
      justify-content: space-between;
    }

    #collection-{{ section.id }} .mobile-filter-sort-option__radio {
      border: 0.1rem solid rgba(0, 0, 0, 0.34);
      border-radius: 50%;
      display: inline-flex;
      flex: 0 0 auto;
      height: 1.45rem;
      margin-left: auto;
      position: relative;
      width: 1.45rem;
    }

    #collection-{{ section.id }} .mobile-filter-sort-option.is-selected .mobile-filter-sort-option__radio::after {
      background: #000;
      border-radius: inherit;
      content: "";
      inset: 0.28rem;
      position: absolute;
    }

    #collection-{{ section.id }} .mobile-filter-sort-options--color {
      flex-direction: row;
      gap: 1.3rem;
      padding-top: 0.6rem;
    }

    #collection-{{ section.id }} .mobile-filter-sort-color-swatch {
      align-items: center;
      appearance: none;
      background: transparent;
      border: 0;
      display: inline-flex;
      justify-content: center;
      padding: 0;
      -webkit-tap-highlight-color: transparent !important;
    }

    #collection-{{ section.id }} .mobile-filter-sort-color-swatch__dot {
      border: 0.1rem solid rgba(0, 0, 0, 0.2);
      border-radius: 50%;
      display: block;
      height: 3.05rem;
      width: 3.05rem;
    }

    #collection-{{ section.id }} .mobile-filter-sort-color-swatch__dot--black {
      background: #000;
    }

    #collection-{{ section.id }} .mobile-filter-sort-color-swatch__dot--white {
      background: #fff;
    }

    #collection-{{ section.id }} .mobile-filter-sort-color-swatch.is-selected .mobile-filter-sort-color-swatch__dot {
      border-color: #000;
      box-shadow: 0 0 0 0.2rem #fff, 0 0 0 0.32rem #000;
    }

    #collection-{{ section.id }} .mobile-filter-sort-color-swatch:focus,
    #collection-{{ section.id }} .mobile-filter-sort-color-swatch:focus-visible,
    #collection-{{ section.id }} .mobile-filter-sort-color-swatch:active {
      box-shadow: none !important;
      outline: none !important;
    }

    #collection-{{ section.id }} .mobile-filter-sort-clear {
      appearance: none;
      background: transparent;
      border: 0;
      color: rgba(0, 0, 0, 0.42);
      display: inline-flex;
      font-family: var(--font-body-family);
      font-size: 1.54rem;
      font-weight: 460;
      justify-content: flex-start;
      letter-spacing: 0;
      line-height: 1.2;
      margin-top: 1.65rem;
      padding: 0;
      text-align: left;
      -webkit-tap-highlight-color: transparent !important;
    }

    #collection-{{ section.id }} .mobile-filter-sort-clear:focus,
    #collection-{{ section.id }} .mobile-filter-sort-clear:focus-visible,
    #collection-{{ section.id }} .mobile-filter-sort-clear:active {
      box-shadow: none !important;
      outline: none !important;
    }

    html.mobile-filter-sort-open,
    html.mobile-filter-sort-open body {
      overflow: hidden !important;
      overscroll-behavior: none;
      touch-action: none;
    }

    #collection-{{ section.id }} .mobile-product-column-toggle__button {
      align-items: center;
      appearance: none;
      background: transparent;
      border: 0;
      border-radius: 999px;
      color: rgba(0, 0, 0, 0.42);
      display: inline-flex;
      height: 4.35rem;
      justify-content: center;
      padding: 0;
      transition: background-color 160ms ease, color 160ms ease;
      width: 7.4rem;
      -webkit-tap-highlight-color: transparent !important;
    }

    #collection-{{ section.id }} .mobile-product-column-toggle__button.is-active {
      background: #fff;
      color: #000;
    }

    #collection-{{ section.id }} .mobile-product-column-toggle__button:focus,
    #collection-{{ section.id }} .mobile-product-column-toggle__button:focus-visible,
    #collection-{{ section.id }} .mobile-product-column-toggle__button:active {
      box-shadow: none !important;
      outline: none !important;
    }

    #collection-{{ section.id }} .mobile-product-column-toggle__icon {
      display: grid;
      gap: 0.25rem;
      height: 1.74rem;
      width: 1.9rem;
    }

    #collection-{{ section.id }} .mobile-product-column-toggle__button[data-mobile-product-columns='1'] .mobile-product-column-toggle__icon {
      grid-template-columns: 1fr;
      height: 2.08rem;
      width: 1.3rem;
    }

    #collection-{{ section.id }} .mobile-product-column-toggle__button[data-mobile-product-columns='2'] .mobile-product-column-toggle__icon {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: repeat(2, 1fr);
    }

    #collection-{{ section.id }} .mobile-product-column-toggle__icon span {
      background: currentColor;
      border-radius: 0.08rem;
      min-height: 100%;
    }

    #collection-{{ section.id }} .mobile-product-column-toggle__button[data-mobile-product-columns='1'] .mobile-product-column-toggle__icon span {
      background: transparent;
      border: 0.18rem solid currentColor;
    }

    #collection-{{ section.id }}[data-mobile-product-columns='1'] .product-grid {
      column-gap: 0 !important;
      row-gap: 2.4rem !important;
    }

    #collection-{{ section.id }}[data-mobile-product-columns='1'] .product-grid .grid__item {
      max-width: 100% !important;
      width: 100% !important;
    }

    #collection-{{ section.id }}[data-mobile-product-columns='2'] .product-grid .grid__item {
      max-width: calc(50% - var(--grid-mobile-horizontal-spacing) / 2) !important;
      width: calc(50% - var(--grid-mobile-horizontal-spacing) / 2) !important;
    }

    #collection-{{ section.id }} .grid__item.is-filter-hidden {
      display: none !important;
    }
  }

  @media screen and (min-width: 750px) {
    {%- if request.page_type == 'index' -%}
      #collection-{{ section.id }}.collection {
        max-width: 100%;
        padding-left: 7.5rem;
        padding-right: 0;
      }

      #collection-{{ section.id }} > .collection__title,
      #collection-{{ section.id }} > .slider-mobile-gutter {
        max-width: 100% !important;
        margin-left: 0;
        margin-right: 0;
        padding-left: 0 !important;
        padding-right: 0 !important;
      }

      #collection-{{ section.id }} > .collection__title {
