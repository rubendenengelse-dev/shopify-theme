      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #collection-{{ section.id }} .collection__view-all .bestsellers-view-all {
      position: relative !important;
      display: inline-block !important;
      overflow: visible !important;
      padding: 0 !important;
      min-width: 0 !important;
      min-height: 0 !important;
      border: 0 !important;
      border-radius: 0 !important;
      background: transparent !important;
      box-shadow: none !important;
      color: rgb(var(--color-foreground)) !important;
      font-family: var(--font-body-family) !important;
      font-style: var(--font-body-style) !important;
      font-weight: 700 !important;
      font-size: 1.5rem !important;
      letter-spacing: normal !important;
      line-height: 1.2 !important;
      text-transform: none !important;
    }

    #collection-{{ section.id }} .collection__title {
      margin-left: -3rem;
    }

    #collection-{{ section.id }} .collection__title .title,
    #collection-{{ section.id }} h2.title,
    #collection-{{ section.id }} .title.inline-richtext {
      font-size: 2.8rem !important;
      line-height: 1.05 !important;
    }

    #collection-{{ section.id }} .collection__title .collection__view-all {
      margin: 0 64rem 0 auto;
      transform: none;
    }

    #collection-{{ section.id }} .collection__view-all .bestsellers-view-all {
      margin-top: calc(1.8rem - 5px) !important;
    }

    #collection-{{ section.id }} .collection__view-all .bestsellers-view-all-text {
      position: relative !important;
      display: inline-block !important;
      padding-bottom: 0.45rem;
      background-image: linear-gradient(currentColor, currentColor);
      background-repeat: no-repeat;
      background-position: left calc(100% - 0.1rem);
      background-size: 100% 1px;
      transition: none !important;
      opacity: 0.95;
    }

    #collection-{{ section.id }} .slider-buttons {
      position: absolute;
      top: 0;
      right: 0;
      z-index: 2;
      transform: translate(-5.5rem, -5.1rem);
      gap: 1rem;
    }

    #collection-{{ section.id }} .slider-button {
      width: 3.4rem;
      height: 3.4rem;
      border-radius: 50%;
      border: 0;
      box-shadow: none;
    }

    #collection-{{ section.id }} .slider-button .svg-wrapper {
      width: 1.1rem;
      height: 1.1rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    #collection-{{ section.id }} .slider-button .svg-wrapper svg {
      width: 1.1rem !important;
      height: 1.1rem !important;
    }

    #collection-{{ section.id }} .slider-counter {
      display: none;
    }

    #collection-{{ section.id }} .slider-button--prev {
      background: #d9d9d9;
      color: #000;
      transform: translateX(-1px);
    }

    #collection-{{ section.id }} .slider-button--prev .svg-wrapper {
      color: #000;
      opacity: 1;
      transform: translateX(-2px);
    }

    #collection-{{ section.id }} .slider-button--prev .svg-wrapper svg {
      fill: currentColor;
      stroke: currentColor;
    }

    #collection-{{ section.id }} .slider-button--prev[disabled] .svg-wrapper,
    #collection-{{ section.id }} .slider-button--prev[disabled] .svg-wrapper svg,
    #collection-{{ section.id }} .slider-button--prev[disabled] .svg-wrapper svg * {
      color: #000 !important;
      fill: #000 !important;
      stroke: #000 !important;
    }

    #collection-{{ section.id }} .slider-button--prev:not([disabled]) {
      background: #000;
      color: #fff;
    }

    #collection-{{ section.id }} .slider-button--prev:not([disabled]) .svg-wrapper,
    #collection-{{ section.id }} .slider-button--prev:not([disabled]) .svg-wrapper svg,
    #collection-{{ section.id }} .slider-button--prev:not([disabled]) .svg-wrapper svg * {
      color: #fff !important;
      fill: #fff !important;
      stroke: #fff !important;
    }

    #collection-{{ section.id }} .slider-button--next {
      background: #000;
      color: #fff;
    }

    #collection-{{ section.id }} .slider-button--next .svg-wrapper {
      color: #fff;
      opacity: 1;
      transform: translateX(2px);
    }

    #collection-{{ section.id }} .slider-button--next .svg-wrapper svg {
      fill: currentColor;
      stroke: currentColor;
    }

    #collection-{{ section.id }} .slider-button--next[disabled] {
      background: #d9d9d9;
      color: #000;
    }

    #collection-{{ section.id }} .slider-button--next[disabled] .svg-wrapper,
    #collection-{{ section.id }} .slider-button--next[disabled] .svg-wrapper svg,
    #collection-{{ section.id }} .slider-button--next[disabled] .svg-wrapper svg * {
