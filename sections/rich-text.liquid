{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- assign render_only_collection_handle = section.settings.render_only_collection_handle | strip -%}
{%- assign should_render_rich_text = true -%}
{%- if render_only_collection_handle != blank -%}
  {%- if request.page_type != 'collection' or collection.handle != render_only_collection_handle -%}
    {%- assign should_render_rich_text = false -%}
  {%- endif -%}
{%- endif -%}
{%- assign is_collection_tshirts_vrouwen = false -%}
{%- if request.page_type == 'collection' and collection.handle == 't-shirts-vrouwen' and render_only_collection_handle == 't-shirts-vrouwen' -%}
  {%- assign is_collection_tshirts_vrouwen = true -%}
{%- endif -%}
{%- assign is_tshirts_template = false -%}
{%- if template.suffix == 't-shirts' or template.suffix == 't-shirts-man' or template.suffix == 't-shirts-vrouw' or template.suffix == 'dames-t-shirts' or template.suffix == 't-shirts-dames' or template.suffix == 't-shirt-mannen' or template.suffix == 'mannen-polo' -%}
  {%- assign is_tshirts_template = true -%}
{%- endif -%}
{%- assign is_hoodies_template = false -%}
{%- if template.suffix == 'hoodies' or template.suffix == 'hoodies-man' or template.suffix == 'hoodies-vrouw' or template.suffix == 'vrouwen-hoodie' or template.suffix == 'hoodies-vrouwen' -%}
  {%- assign is_hoodies_template = true -%}
{%- endif -%}
{%- assign is_oversize_tshirts_template = false -%}
{%- if template.suffix == 'oversize-t-shirt-s' -%}
  {%- assign is_oversize_tshirts_template = true -%}
{%- endif -%}
{%- assign is_mannen_polo_page = false -%}
{%- if page_title contains 'Mannen Polo' -%}
  {%- assign is_mannen_polo_page = true -%}
{%- endif -%}
{%- assign is_tshirts_like_rich_text = false -%}
{%- if is_tshirts_template or is_hoodies_template or is_oversize_tshirts_template or is_collection_tshirts_vrouwen -%}
  {%- assign is_tshirts_like_rich_text = true -%}
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (max-width: 749px) {
    {% if is_tshirts_like_rich_text %}
      .section-{{ section.id }}-padding .rich-text__heading--desktop-page-hero {
        font-family: var(--font-body-family) !important;
        font-style: var(--font-body-style) !important;
        font-weight: 900 !important;
        letter-spacing: 0.14em !important;
        text-transform: uppercase !important;
        line-height: 1.05 !important;
      }

      .section-{{ section.id }}-padding .rich-text__heading.rte.inline-richtext.h2 {
        font-family: var(--font-body-family) !important;
        font-style: var(--font-body-style) !important;
        font-size: 1.65rem !important;
        font-weight: 800 !important;
        letter-spacing: 0.14em !important;
        text-transform: uppercase !important;
        color: rgba(0, 0, 0, 0.42) !important;
        margin-top: 1rem !important;
        margin-bottom: 0.35rem !important;
      }

      .section-{{ section.id }}-padding .rich-text__heading.rte.inline-richtext.h2 + .rich-text__text {
        margin-top: 0 !important;
      }

      .section-{{ section.id }}-padding .rich-text__mobile-readmore {
        display: inline;
      }

      .section-{{ section.id }}-padding .rich-text__mobile-readmore[hidden] {
        display: none !important;
      }

      .section-{{ section.id }}-padding .rich-text__mobile-readmore-button {
        display: inline;
        margin-left: 0.35rem;
        padding: 0;
        color: #000000;
        font: inherit;
        font-weight: 700;
        line-height: inherit;
        text-decoration: none;
        cursor: pointer !important;
        user-select: none;
        outline: none;
      }

      .section-{{ section.id }}-padding .rich-text__mobile-readmore-button:hover,
      .section-{{ section.id }}-padding .rich-text__mobile-readmore-button:focus,
      .section-{{ section.id }}-padding .rich-text__mobile-readmore-button:focus-visible,
      .section-{{ section.id }}-padding .rich-text__mobile-readmore-button:active {
        color: #000000;
        cursor: pointer !important;
      }

      .section-{{ section.id }}-padding .rich-text__mobile-readmore-button:focus,
      .section-{{ section.id }}-padding .rich-text__mobile-readmore-button:focus-visible,
      .section-{{ section.id }}-padding .rich-text__mobile-readmore-button:active {
        outline: none;
        box-shadow: none;
      }

      .section-{{ section.id }}-padding .rich-text__mobile-readmore-button[hidden] {
        display: none !important;
      }

      .section-{{ section.id }}-padding .rich-text__mobile-readmore-intro {
        display: inline;
      }

      {% if is_hoodies_template or is_tshirts_template or is_collection_tshirts_vrouwen %}
        .section-{{ section.id }}-padding .rich-text__mobile-readmore-intro {
          display: block;
        }

        .section-{{ section.id }}-padding .rich-text__mobile-readmore-button {
          display: block;
          margin-top: 0.1rem;
          margin-left: 0;
        }

        .section-{{ section.id }}-padding .rich-text__mobile-readmore > p {
          margin-top: 0.9rem;
        }
      {% endif %}

      .section-{{ section.id }}-padding .rich-text__mobile-readless-button {
        display: block;
        margin-top: 0.1rem;
        padding: 0;
        color: #000000;
        font: inherit;
        font-weight: 700;
        line-height: inherit;
        text-decoration: none;
        cursor: pointer !important;
        user-select: none;
        outline: none;
      }

      .section-{{ section.id }}-padding .rich-text__mobile-readless-button:hover,
      .section-{{ section.id }}-padding .rich-text__mobile-readless-button:focus,
      .section-{{ section.id }}-padding .rich-text__mobile-readless-button:focus-visible,
      .section-{{ section.id }}-padding .rich-text__mobile-readless-button:active {
        color: #000000;
        cursor: pointer !important;
      }

      .section-{{ section.id }}-padding .rich-text__mobile-readless-button:focus,
      .section-{{ section.id }}-padding .rich-text__mobile-readless-button:focus-visible,
      .section-{{ section.id }}-padding .rich-text__mobile-readless-button:active {
        outline: none;
        box-shadow: none;
      }

      .section-{{ section.id }}-padding .rich-text__mobile-readless-button[hidden] {
        display: none !important;
      }
    {% endif %}
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    {% if is_tshirts_like_rich_text %}
      .section-{{ section.id }}-padding .rich-text__wrapper.page-width {
        max-width: 100%;
        padding-left: 4.5rem;
        padding-right: 5rem;
        margin-left: 0;
        margin-right: auto;
      }

      .section-{{ section.id }}-padding .rich-text__heading--desktop-page-hero {
        font-family: var(--font-body-family) !important;
        font-style: var(--font-body-style) !important;
        font-weight: 900 !important;
        font-size: 4.4rem !important;
        letter-spacing: 0.18em !important;
        text-transform: uppercase !important;
        line-height: 1.05 !important;
      }

      {% if is_oversize_tshirts_template or is_hoodies_template %}
        .section-{{ section.id }}-padding .rich-text__heading--desktop-page-hero + .rich-text__text {
          font-size: 1.75rem;
          line-height: 1.75;
        }

        .section-{{ section.id }}-padding .rich-text__heading--desktop-page-hero + .rich-text__text p {
          max-width: 96rem;
        }
      {% endif %}

      {% if is_oversize_tshirts_template or is_tshirts_template or is_hoodies_template or is_collection_tshirts_vrouwen %}
        .section-{{ section.id }}-padding .rich-text__heading.rte.inline-richtext.h2 {
          font-family: var(--font-body-family) !important;
          font-style: var(--font-body-style) !important;
          font-size: 1.9rem !important;
          font-weight: 800 !important;
          letter-spacing: 0.14em !important;
          text-transform: uppercase !important;
          line-height: 1.15 !important;
          color: rgba(0, 0, 0, 0.42) !important;
          transform: translateY(0.4rem);
        }

        .section-{{ section.id }}-padding .rich-text__heading.rte.inline-richtext.h2 + .rich-text__text {
          width: 100%;
          max-width: none;
          margin-top: 0.6rem;
          font-size: 1.6rem;
          line-height: 1.75;
        }

        .section-{{ section.id }}-padding .rich-text__heading.rte.inline-richtext.h2 + .rich-text__text p {
          max-width: none;
        }

        .section-{{ section.id }}-padding .rich-text__heading.rte.inline-richtext.h2 ~ .rich-text__text {
          width: 100%;
          max-width: none;
        }

        .section-{{ section.id }}-padding .rich-text__blocks:has(.rich-text__heading.rte.inline-richtext.h2) {
          width: 100%;
          max-width: none;
        }
      {% endif %}

      {% if is_hoodies_template or is_tshirts_template or is_collection_tshirts_vrouwen %}
        .section-{{ section.id }}-padding .rich-text__mobile-readmore[hidden] {
          display: none !important;
        }

        .section-{{ section.id }}-padding .rich-text__mobile-readmore-button,
        .section-{{ section.id }}-padding .rich-text__mobile-readless-button {
          color: #000000 !important;
          cursor: pointer !important;
          user-select: none;
          text-decoration: none !important;
        }

        .section-{{ section.id }}-padding .rich-text__mobile-readmore-button:hover,
        .section-{{ section.id }}-padding .rich-text__mobile-readmore-button:focus,
        .section-{{ section.id }}-padding .rich-text__mobile-readmore-button:focus-visible,
        .section-{{ section.id }}-padding .rich-text__mobile-readmore-button:active,
        .section-{{ section.id }}-padding .rich-text__mobile-readless-button:hover,
        .section-{{ section.id }}-padding .rich-text__mobile-readless-button:focus,
        .section-{{ section.id }}-padding .rich-text__mobile-readless-button:focus-visible,
        .section-{{ section.id }}-padding .rich-text__mobile-readless-button:active {
          color: #000000 !important;
          cursor: pointer !important;
        }

        .section-{{ section.id }}-padding .rich-text__mobile-readmore-button[hidden] {
          display: none !important;
        }

        .section-{{ section.id }}-padding .rich-text__mobile-readless-button[hidden] {
          display: none !important;
        }

        .section-{{ section.id }}-padding .rich-text__mobile-readmore-intro {
          display: block;
        }

        .section-{{ section.id }}-padding .rich-text__mobile-readmore-button {
          display: block;
          margin-top: 0.1rem;
          margin-left: 0;
        }

        .section-{{ section.id }}-padding .rich-text__mobile-readmore > p {
          margin-top: 0.9rem;
        }
      {% endif %}
    {% endif %}
  }
{%- endstyle -%}

{% if should_render_rich_text %}
<div class="isolate{% unless section.settings.full_width %} page-width{% endunless %}">
  <div class="rich-text content-container color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} rich-text--full-width content-container--full-width{% endif %} section-{{ section.id }}-padding">
    <div class="rich-text__wrapper rich-text__wrapper--{{ section.settings.desktop_content_position }}{% if section.settings.full_width %} page-width{% endif %}">
      <div class="rich-text__blocks {{ section.settings.content_alignment }}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              {%- liquid
                assign rendered_heading = block.settings.heading
                if is_mannen_polo_page
                  if section.id contains 'rich_text_yGBKb3'
                    assign rendered_heading = "POLO'S"
                  elsif section.id contains 'rich_text_rnxHdp'
                    assign rendered_heading = "POLO'S VAN WOG"
                  endif
                endif
              -%}
              <h2
                class="rich-text__heading rte inline-richtext {{ block.settings.heading_size }}{% if block.settings.heading_size == 'h1' and is_tshirts_like_rich_text %} rich-text__heading--desktop-page-hero{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {{ rendered_heading }}
              </h2>
            {%- when 'caption' -%}
              <p
                class="rich-text__caption {{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {{ block.settings.caption | escape }}
              </p>
            {%- when 'text' -%}
              {%- liquid
                assign rendered_text = block.settings.text
                if is_mannen_polo_page
                  if section.id contains 'rich_text_yGBKb3'
                    assign rendered_text = "<p>Onze polo's combineren dagelijks comfort met een verzorgde uitstraling. Gemaakt met oog voor detail, ontworpen voor momenten waarop je stijlvol en ontspannen voor de dag wilt komen, en gedragen met een boodschap die verder gaat dan trends.<br/><br/>Dit is meer dan mode. Het is een manier om Gods Woord zichtbaar te dragen, verpakt in kwaliteit en vakmanschap. Ontworpen met passie voor God en gedreven door een missie om de kledingindustrie eerlijker en bewuster te maken.<br/><br/></p>"
                  elsif section.id contains 'rich_text_rnxHdp'
                    assign rendered_text = "<p>WOG polo's zijn meer dan een bewuste keuze: het staat voor kwaliteit, verantwoordelijkheid en respect voor mens en milieu. Onze kleding wordt gemaakt met aandacht voor materiaal, pasvorm en langdurig draagcomfort.</p><p><br/>Een polo geeft je outfit een nettere uitstraling zonder het gemak van casual kleding te verliezen. Daardoor past hij goed bij werk, vrije tijd en momenten waarop je bewust verzorgd voor de dag wilt komen.</p><p><br/>Door te kiezen voor Warrior of God draag je bij aan een eerlijkere kledingindustrie. Minder milieuvervuiling, betere werkomstandigheden en kleding die met zorg is gemaakt: dat is stijl met impact.<br/>Maak een verschil met wat je aantrekt. Draag bewust. Draag WOG. <br/><br/></p>"
                  endif
                endif
              -%}
              <div
                class="rich-text__text rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {{ rendered_text }}
              </div>
            {%- when 'button' -%}
              <div
                class="rich-text__buttons{% if block.settings.button_label != blank and block.settings.button_label_2 != blank %} rich-text__buttons--multiple{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {%- if block.settings.button_label != blank -%}
                  <a
                    {% if block.settings.button_link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.button_link }}"
                    {% endif %}
                    class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                  >
                    {{- block.settings.button_label | escape -}}
                  </a>
                {%- endif -%}
                {%- if block.settings.button_label_2 != blank -%}
                  <a
                    {% if block.settings.button_link_2 == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.button_link_2 }}"
                    {% endif %}
                    class="button{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}"
                  >
                    {{- block.settings.button_label_2 | escape -}}
                  </a>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>
{% endif %}

{% if should_render_rich_text and is_tshirts_like_rich_text %}
  <script>
    (() => {
      const applyMobileReadMore = () => {
        if (
          window.innerWidth >= 750
          && !{{ is_hoodies_template | json }}
          && !{{ is_tshirts_template | json }}
          && !{{ is_collection_tshirts_vrouwen | json }}
        ) return;

        const section = document.querySelector('.section-{{ section.id }}-padding');
        if (!section || section.dataset.mobileReadmoreApplied === 'true') return;

        const heroHeading = section.querySelector('.rich-text__heading--desktop-page-hero');
        const introText = heroHeading ? heroHeading.nextElementSibling : null;
        if (!introText || !introText.classList.contains('rich-text__text')) return;

        const paragraph = introText.querySelector('p');
        if (!paragraph) return;

        const fullText = paragraph.innerHTML.trim();
        if ({{ is_hoodies_template | json }} || {{ is_tshirts_template | json }} || {{ is_collection_tshirts_vrouwen | json }}) {
          const paragraphBreakMatch = fullText.match(/<br\s*\/?>\s*<br\s*\/?>/i);
          if (!paragraphBreakMatch) return;

          const splitIndex = paragraphBreakMatch.index;
          const visiblePart = fullText.slice(0, splitIndex).trim();
          const hiddenPart = fullText
            .slice(splitIndex + paragraphBreakMatch[0].length)
            .trim();

          if (!visiblePart || !hiddenPart) return;

          introText.innerHTML = `
            <p>
              <span class="rich-text__mobile-readmore-intro">${visiblePart}</span>
            </p>
            <span class="rich-text__mobile-readmore-button" role="button" tabindex="0">...Bekijk meer</span>
            <div class="rich-text__mobile-readmore" hidden>
              <p>${hiddenPart}</p>
            </div>
            <span class="rich-text__mobile-readless-button" role="button" tabindex="0" hidden>Zie minder</span>
          `;

          const hiddenContent = introText.querySelector('.rich-text__mobile-readmore');
          const button = introText.querySelector('.rich-text__mobile-readmore-button');
          const readLessButton = introText.querySelector('.rich-text__mobile-readless-button');

          const handleToggleKeydown = (event, callback) => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              callback();
            }
          };

          const showMore = () => {
            hiddenContent.hidden = false;
            button.hidden = true;
            readLessButton.hidden = false;
          };

          const showLess = () => {
            hiddenContent.hidden = true;
            button.hidden = false;
            readLessButton.hidden = true;
          };

          button.addEventListener('click', showMore);
          button.addEventListener('keydown', (event) => handleToggleKeydown(event, showMore));
          readLessButton.addEventListener('click', showLess);
          readLessButton.addEventListener('keydown', (event) => handleToggleKeydown(event, showLess));

          section.dataset.mobileReadmoreApplied = 'true';
          return;
        }

        const splitMarkers = {
          't-shirts': 'Onze T-shirts vormen de basis van elke sterke outfit.',
          't-shirts-man': 'Onze T-shirts vormen de basis van elke sterke outfit.',
          't-shirts-vrouw': 'Onze T-shirts vormen de basis van elke sterke outfit.',
          'dames-t-shirts': 'Onze T-shirts vormen de basis van elke sterke outfit.',
          't-shirts-dames': 'Onze T-shirts vormen de basis van elke sterke outfit.',
          't-shirt-mannen': 'Onze T-shirts vormen de basis van elke sterke outfit.',
          'mannen-polo': 'Onze polo’s combineren dagelijks comfort met een verzorgde uitstraling.',
          'hoodies': 'Onze hoodies zijn gemaakt om elke dag te dragen.',
          'hoodies-man': 'Onze hoodies zijn gemaakt om elke dag te dragen.',
          'hoodies-vrouw': 'Onze hoodies zijn gemaakt om elke dag te dragen.',
          'vrouwen-hoodie': 'Onze hoodies zijn gemaakt om elke dag te dragen.',
          'hoodies-vrouwen': 'Onze hoodies zijn gemaakt om elke dag te dragen.',
          'oversize-t-shirt-s': 'Onze oversized T-shirts zijn een absolute must-have voor jouw collectie.'
        };
        const splitMarker = splitMarkers['{{ template.suffix }}'];
        if (!splitMarker) return;
        const splitIndex = fullText.indexOf(splitMarker);
        if (splitIndex === -1) return;

        const visiblePart = fullText.slice(0, splitIndex + splitMarker.length);
        const hiddenPart = fullText.slice(splitIndex + splitMarker.length).trim();
        if (!hiddenPart) return;

        introText.innerHTML = `
          <p>
            <span class="rich-text__mobile-readmore-intro">${visiblePart}</span><span class="rich-text__mobile-readmore-button" role="button" tabindex="0">...Bekijk meer</span>
            <span class="rich-text__mobile-readmore" hidden> ${hiddenPart}</span>
          </p>
          <span class="rich-text__mobile-readless-button" role="button" tabindex="0" hidden>Zie minder</span>
        `;

        const hiddenContent = introText.querySelector('.rich-text__mobile-readmore');
        const button = introText.querySelector('.rich-text__mobile-readmore-button');
        const readLessButton = introText.querySelector('.rich-text__mobile-readless-button');

        const handleToggleKeydown = (event, callback) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            callback();
          }
        };

        const showMore = () => {
          hiddenContent.hidden = false;
          button.hidden = true;
          readLessButton.hidden = false;
        };

        const showLess = () => {
          hiddenContent.hidden = true;
          button.hidden = false;
          readLessButton.hidden = true;
        };

        button.addEventListener('click', showMore);
        button.addEventListener('keydown', (event) => handleToggleKeydown(event, showMore));
        readLessButton.addEventListener('click', showLess);
        readLessButton.addEventListener('keydown', (event) => handleToggleKeydown(event, showLess));

        section.dataset.mobileReadmoreApplied = 'true';
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', applyMobileReadMore, { once: true });
      } else {
        applyMobileReadMore();
      }
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "t:sections.rich-text.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "render_only_collection_handle",
      "label": "Render only on collection handle",
      "info": "Optional. Leave blank to show everywhere."
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        {
          "value": "left",
          "label": "t:sections.rich-text.settings.desktop_content_position.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.rich-text.settings.desktop_content_position.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.rich-text.settings.desktop_content_position.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.rich-text.settings.desktop_content_position.label"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.rich-text.settings.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.rich-text.settings.content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.rich-text.settings.content_alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.rich-text.settings.content_alignment.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
