  <body
    class="gradient{% if settings.animations_hover_elements != 'none' %} animate--hover-{{ settings.animations_hover_elements }}{% endif %}"
    data-customer-logged-in="{% if customer %}true{% else %}false{% endif %}"
    data-account-login-url="{{ routes.account_login_url }}"
    data-account-wishlist-url="{{ routes.account_url }}#wishlist"
    data-wishlist-endpoint="/apps/wishlist/proxy"
  >
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {%- if settings.cart_type == 'drawer' -%}
      {%- render 'cart-drawer' -%}
    {%- endif -%}

    <div class="product-info-drawer wog-global-cart-drawer" data-wog-global-cart-drawer aria-hidden="true">
      <button type="button" class="product-info-drawer__overlay" data-wog-global-cart-close aria-label="{{ 'accessibility.close' | t }}"></button>
      <aside class="product-info-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="WogGlobalCartDrawerTitle">
        <div class="product-info-drawer__header">
          <h2 id="WogGlobalCartDrawerTitle">WINKELWAGEN</h2>
          <button type="button" class="product-info-drawer__close" data-wog-global-cart-close aria-label="{{ 'accessibility.close' | t }}">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </button>
          <div class="product-info-drawer__mobile-header-toggle" aria-label="Wissel tussen winkelwagen en wishlist">
            <button type="button" class="product-info-drawer__mobile-header-button is-active" aria-label="Winkelwagen" aria-pressed="true">
              <span class="product-info-drawer__mobile-header-icon">
                {{- 'icon-cart-empty.svg' | inline_asset_content -}}
              </span>
            </button>
            <a class="product-info-drawer__mobile-header-button product-info-drawer__mobile-header-button--wishlist" href="{{ routes.account_url }}#wishlist" aria-label="Wishlist" data-mobile-cart-wishlist-link>
              <span class="product-info-drawer__mobile-header-icon">
                {{- 'icon-heart.svg' | inline_asset_content -}}
              </span>
            </a>
          </div>
        </div>
        <div class="product-info-drawer__body" data-wog-global-cart-body></div>
      </aside>
    </div>

    <div class="product-info-drawer wog-global-cart-drawer wog-global-wishlist-drawer" data-wog-global-wishlist-drawer aria-hidden="true">
      <button type="button" class="product-info-drawer__overlay" data-wog-global-wishlist-close aria-label="{{ 'accessibility.close' | t }}"></button>
      <aside class="product-info-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="WogGlobalWishlistDrawerTitle">
        <div class="product-info-drawer__header">
          <h2 id="WogGlobalWishlistDrawerTitle">VERLANGLIJSTJE</h2>
          <button type="button" class="product-info-drawer__close" data-wog-global-wishlist-close aria-label="{{ 'accessibility.close' | t }}">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </button>
          <div class="product-info-drawer__mobile-header-toggle is-wishlist-active" aria-label="Wissel tussen winkelwagen en wishlist">
            <button type="button" class="product-info-drawer__mobile-header-button" aria-label="Winkelwagen" aria-pressed="false" data-mobile-wishlist-open-cart>
              <span class="product-info-drawer__mobile-header-icon">
                {{- 'icon-cart-empty.svg' | inline_asset_content -}}
              </span>
            </button>
            <button type="button" class="product-info-drawer__mobile-header-button product-info-drawer__mobile-header-button--wishlist is-active" aria-label="Wishlist" aria-pressed="true">
              <span class="product-info-drawer__mobile-header-icon">
                {{- 'icon-heart.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>
        </div>
        <div class="product-info-drawer__body" data-wog-global-wishlist-body></div>
      </aside>
    </div>

    {%- unless template.name == 'login' or template.name == 'register' -%}
      {% sections 'header-group' %}
    {%- endunless -%}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {%- unless template.name == 'login' or template.name == 'register' -%}
      {% sections 'footer-group' %}
    {%- endunless -%}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}',
      };

      window.cartStrings = {
        error: `{{ 'sections.cart.cart_error' | t }}`,
        quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`,
      };

      window.variantStrings = {
        addToCart: `{{ 'products.product.add_to_cart' | t }}`,
        soldOut: `{{ 'products.product.sold_out' | t }}`,
        unavailable: `{{ 'products.product.unavailable' | t }}`,
        unavailable_with_option: `{{ 'products.product.value_unavailable' | t: option_value: '[value]' }}`,
      };

      window.quickOrderListStrings = {
        itemsAdded: `{{ 'sections.quick_order_list.items_added.other' | t: quantity: '[quantity]' }}`,
        itemAdded: `{{ 'sections.quick_order_list.items_added.one' | t: quantity: '[quantity]' }}`,
        itemsRemoved: `{{ 'sections.quick_order_list.items_removed.other' | t: quantity: '[quantity]' }}`,
        itemRemoved: `{{ 'sections.quick_order_list.items_removed.one' | t: quantity: '[quantity]' }}`,
        viewCart: `{{- 'sections.quick_order_list.view_cart' | t -}}`,
        each: `{{- 'sections.quick_order_list.each' | t: money: '[money]' }}`,
        min_error: `{{- 'sections.quick_order_list.min_error' | t: min: '[min]' }}`,
        max_error: `{{- 'sections.quick_order_list.max_error' | t: max: '[max]' }}`,
        step_error: `{{- 'sections.quick_order_list.step_error' | t: step: '[step]' }}`,
      };

      window.accessibilityStrings = {
        imageAvailable: `{{ 'products.product.media.image_available' | t: index: '[index]' }}`,
        shareSuccess: `{{ 'general.share.success_message' | t }}`,
        pauseSlideshow: `{{ 'sections.slideshow.pause_slideshow' | t }}`,
        playSlideshow: `{{ 'sections.slideshow.play_slideshow' | t }}`,
        recipientFormExpanded: `{{ 'recipient.form.expanded' | t }}`,
        recipientFormCollapsed: `{{ 'recipient.form.collapsed' | t }}`,
        countrySelectorSearchCount: `{{ 'localization.country_results_count' | t: count: '[count]' }}`,
      };
    </script>

    {%- if settings.predictive_search_enabled -%}
      <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if settings.cart_type == 'drawer' -%}
      <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    <script>
      {%- if request.page_type == 'cart' -%}
        window.location.replace('/?open-cart=1');
      {%- endif -%}

      const globalCartDrawer = document.querySelector('[data-wog-global-cart-drawer]');
      const globalCartDrawerBody = globalCartDrawer?.querySelector('[data-wog-global-cart-body]');
      const globalCartDrawerCloseButtons = globalCartDrawer ? Array.from(globalCartDrawer.querySelectorAll('[data-wog-global-cart-close]')) : [];
      const globalWishlistDrawer = document.querySelector('[data-wog-global-wishlist-drawer]');
      const globalWishlistDrawerBody = globalWishlistDrawer?.querySelector('[data-wog-global-wishlist-body]');
      const globalWishlistDrawerCloseButtons = globalWishlistDrawer ? Array.from(globalWishlistDrawer.querySelectorAll('[data-wog-global-wishlist-close]')) : [];

      const escapeGlobalCartHTML = (value = '') =>
        String(value).replace(/[&<>"']/g, (character) => {
          return {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;',
          }[character];
        });

      const formatGlobalCartMoney = (cents = 0) =>
        new Intl.NumberFormat('nl-NL', {
          style: 'currency',
          currency: 'EUR',
        }).format(Number(cents || 0) / 100);

      const formatGlobalWishlistPrice = (price) => {
        if (!price?.amount || !price?.currencyCode) return '';

        try {
          const rawAmount = String(price.amount).trim();
          let numericAmount = Number(rawAmount);

          if (Number.isFinite(numericAmount) && numericAmount >= 1000) {
            const looksLikeCents =
              /^[0-9]+$/.test(rawAmount) ||
              /^[0-9]+\.0+$/.test(rawAmount) ||
              /^[0-9]+,0+$/.test(rawAmount);

            if (looksLikeCents) numericAmount = numericAmount / 100;
          }

          return new Intl.NumberFormat('nl-NL', {
            style: 'currency',
            currency: price.currencyCode,
          }).format(numericAmount);
        } catch (error) {
          return `${price.amount} ${price.currencyCode}`;
        }
      };

      const getGlobalWishlistImageUrl = (url, width = 240) => {
        if (!url) return '';

        try {
          const parsed = new URL(url, window.location.origin);
          parsed.searchParams.set('width', String(width));
          return parsed.toString();
        } catch (error) {
          return url;
        }
      };

      const globalCartCheckoutIcon = `{{ 'icon-cart-empty.svg' | inline_asset_content | strip_newlines }}`;
      const globalCartPaymentIcons = `
        <div class="product-info-drawer__payment-icons" aria-label="{{ 'sections.footer.payment' | t }}">
          <ul class="list list-payment" role="list">
            {%- assign enabled_payment_type_names = shop.enabled_payment_types | join: ',' -%}
            {%- for type in shop.enabled_payment_types -%}
              <li class="list-payment__item">
                {{ type | payment_type_svg_tag: class: 'icon icon--full-color' | strip_newlines }}
              </li>
            {%- endfor -%}
            {%- unless enabled_payment_type_names contains 'ideal' -%}
              <li class="list-payment__item">
                {{ 'ideal' | payment_type_svg_tag: class: 'icon icon--full-color' | strip_newlines }}
              </li>
            {%- endunless -%}
          </ul>
        </div>
      `;

      const updateGlobalCartIcon = async () => {
        try {
          const response = await fetch(`${window.Shopify?.routes?.root || '/'}?sections=cart-icon-bubble`, {
            headers: { Accept: 'application/json' },
          });
          if (!response.ok) return;
          const sections = await response.json();
          const cartIconSection = sections['cart-icon-bubble'];
          if (!cartIconSection) return;
          const currentCartIcon = document.getElementById('shopify-section-cart-icon-bubble');
          const updatedCartIcon = new DOMParser()
            .parseFromString(cartIconSection, 'text/html')
            .getElementById('shopify-section-cart-icon-bubble');
          if (currentCartIcon && updatedCartIcon) currentCartIcon.innerHTML = updatedCartIcon.innerHTML;
        } catch (error) {
          console.error(error);
        }
      };

      const getGlobalCartState = async () => {
        const response = await fetch(`${window.routes?.cart_url || '/cart'}.js`, {
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error('Cart fetch failed');
        return response.json();
      };

      const buildGlobalCartItems = (cartItems = []) => {
        if (!cartItems.length) {
          return '<p class="product-info-drawer__cart-empty">Je winkelwagen is leeg.</p>';
        }

        return `
          <div class="product-info-drawer__cart-list">
            ${cartItems
              .map((item) => {
                const itemTitle = item.product_title || item.title || 'Product';
                const itemVariantTitle = item.variant_title && item.variant_title !== 'Default Title' ? item.variant_title : '';
                const itemQuantity = Math.max(Number(item.quantity || 1), 0);
                const itemLinePrice = formatGlobalCartMoney(item.final_line_price || item.final_price || item.price);
                const itemImageMarkup = item.image
                  ? `<img class="product-info-drawer__cart-image" src="${escapeGlobalCartHTML(item.image)}" alt="${escapeGlobalCartHTML(itemTitle)}" loading="lazy">`
                  : '<span class="product-info-drawer__cart-image" aria-hidden="true"></span>';

                return `
                  <div class="product-info-drawer__cart-item">
                    ${itemImageMarkup}
                    <div class="product-info-drawer__cart-details">
                      <p class="product-info-drawer__cart-title">${escapeGlobalCartHTML(itemTitle)}</p>
                      ${itemVariantTitle ? `<p class="product-info-drawer__cart-meta">${escapeGlobalCartHTML(itemVariantTitle)}</p>` : ''}
                      <p class="product-info-drawer__cart-price">${itemQuantity} x ${itemLinePrice}</p>
                      <div class="product-info-drawer__quantity" data-global-cart-line-key="${escapeGlobalCartHTML(item.key)}" data-global-cart-line-quantity="${itemQuantity}">
                        <button class="product-info-drawer__quantity-button" type="button" data-global-cart-quantity-action="minus" aria-label="Aantal verlagen">
                          <svg viewBox="0 0 12 12" focusable="false" aria-hidden="true">
                            <path d="M2 6h8" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round"/>
                          </svg>
                        </button>
                        <span class="product-info-drawer__quantity-count">${itemQuantity}</span>
                        <button class="product-info-drawer__quantity-button" type="button" data-global-cart-quantity-action="plus" aria-label="Aantal verhogen">
                          <svg viewBox="0 0 12 12" focusable="false" aria-hidden="true">
                            <path d="M6 2v8M2 6h8" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round"/>
                          </svg>
                        </button>
                      </div>
                    </div>
                  </div>
                `;
              })
              .join('')}
          </div>
        `;
      };

      const buildGlobalCartContent = (cartState = {}) => {
        const cartItems = Array.isArray(cartState.items) ? cartState.items : [];
        const freeShippingTarget = 6900;
        const cartTotal = Number(cartState.total_price || 0);
        const deliveryPrice = cartTotal >= freeShippingTarget || cartTotal === 0 ? 0 : 495;
        const orderTotal = cartTotal + deliveryPrice;
        const remainingForFreeShipping = Math.max(freeShippingTarget - cartTotal, 0);
        const shippingProgress = Math.min(Math.round((cartTotal / freeShippingTarget) * 100), 100);
        const shippingMessage =
          remainingForFreeShipping === 0
            ? 'Je hebt gratis verzending unlocked.'
            : `Nog ${formatGlobalCartMoney(remainingForFreeShipping)} tot gratis verzending.`;

        return `
          <div class="product-info-drawer__cart-added">
            <div class="product-info-drawer__cart-scroll">
              <div class="product-info-drawer__shipping-tracker${remainingForFreeShipping === 0 ? ' is-complete' : ''}">
                <p class="product-info-drawer__shipping-title">Gratis verzending vanaf ${formatGlobalCartMoney(freeShippingTarget)}</p>
                <p class="product-info-drawer__shipping-message">${shippingMessage}</p>
                <div class="product-info-drawer__shipping-track" aria-hidden="true">
                  <span class="product-info-drawer__shipping-progress" data-global-shipping-progress="${shippingProgress}" style="--shipping-progress: 0%"></span>
                </div>
              </div>
              ${buildGlobalCartItems(cartItems)}
              <div class="product-info-drawer__cart-actions">
                <div class="product-info-drawer__order-summary">
                  <p class="product-info-drawer__summary-heading">Samenvatting van bestelling</p>
                  <div class="product-info-drawer__summary-row">
                    <span>Totaal</span>
                    <span>${formatGlobalCartMoney(cartTotal)}</span>
                  </div>
                  <div class="product-info-drawer__summary-row">
                    <span>Standaard verzending</span>
                    <span>${deliveryPrice === 0 ? 'Vrij' : formatGlobalCartMoney(deliveryPrice)}</span>
                  </div>
                  <div class="product-info-drawer__summary-row product-info-drawer__summary-row--total">
                    <span>Totaal</span>
                    <span>${formatGlobalCartMoney(orderTotal)}</span>
                  </div>
                </div>
              </div>
            </div>
            <div class="product-info-drawer__checkout-anchor">
              <a class="product-info-drawer__cart-button product-info-drawer__cart-button--primary" href="/checkout">
                <span class="product-info-drawer__cart-button-icon">${globalCartCheckoutIcon}</span>
                <span>Veilig afrekenen</span>
              </a>
              ${globalCartPaymentIcons}
            </div>
          </div>
        `;
      };

      const buildGlobalWishlistContent = (payload = {}) => {
        const products = Array.isArray(payload?.wishlist?.products) ? payload.wishlist.products : [];

        if (!products.length) {
          return `<p class="product-info-drawer__wishlist-empty">Je hebt nog geen producten aan je verlanglijstje toegevoegd.</p>`;
        }

        return `
          <div class="product-info-drawer__wishlist-grid">
            ${products
              .map((product) => {
                const productTitle = escapeGlobalCartHTML(product.title || 'Product');
                const productUrl = escapeGlobalCartHTML(product.url || '#');
                const productPrice = product.price ? `<p class="product-info-drawer__wishlist-price">${formatGlobalWishlistPrice(product.price)}</p>` : '';
                const productImage = product.image?.url
                  ? `
                    <div class="product-info-drawer__wishlist-media">
                      <img src="${escapeGlobalCartHTML(getGlobalWishlistImageUrl(product.image.url, 220))}" alt="${escapeGlobalCartHTML(product.image.alt || product.title || 'Product')}" loading="lazy">
                    </div>
                  `
                  : '';
                const sizeSelector = `
                  <div class="product-info-drawer__wishlist-purchase">
                    <div class="product-info-drawer__wishlist-size">
                    <details class="account-wishlist__size-picker">
                      <summary class="account-wishlist__size-summary">
                        <span class="account-wishlist__size-summary-label">Maat selecteren</span>
                        <svg viewBox="0 0 12 12" focusable="false" aria-hidden="true">
                          <path d="M2.75 4.25 6 7.5l3.25-3.25" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </summary>
                      <div class="account-wishlist__size-options" role="list">
                        <button type="button" class="account-wishlist__size-option" data-size-value="XS">XS</button>
                        <button type="button" class="account-wishlist__size-option" data-size-value="S">S</button>
                        <button type="button" class="account-wishlist__size-option" data-size-value="M">M</button>
                        <button type="button" class="account-wishlist__size-option" data-size-value="L">L</button>
                        <button type="button" class="account-wishlist__size-option" data-size-value="XL">XL</button>
                        <button type="button" class="account-wishlist__size-option" data-size-value="XXL">XXL</button>
                      </div>
                    </details>
                    </div>
                    <button
                      type="button"
                      class="product-info-drawer__wishlist-cart-trigger"
                      aria-label="Toevoegen aan winkelwagen"
                      data-mobile-wishlist-cart
                      data-product-url="${productUrl}"
                    >
                      ${globalCartCheckoutIcon}
                    </button>
                  </div>
                `;

                return `
                  <article class="product-info-drawer__wishlist-item">
                    <div class="product-info-drawer__wishlist-card">
                      <a class="product-info-drawer__wishlist-link" href="${productUrl}">
                        ${productImage}
                      </a>
                      <div class="product-info-drawer__wishlist-details">
                        <a class="product-info-drawer__wishlist-link" href="${productUrl}">
                          <p class="product-info-drawer__wishlist-title">${productTitle}</p>
                          ${productPrice}
                        </a>
                        ${sizeSelector}
                      </div>
                    </div>
                  </article>
                `;
              })
              .join('')}
          </div>
        `;
      };

      const animateGlobalShippingProgress = () => {
        const progress = globalCartDrawerBody?.querySelector('[data-global-shipping-progress]');
        if (!progress) return;
        const targetProgress = progress.dataset.globalShippingProgress;
        window.requestAnimationFrame(() => {
          window.requestAnimationFrame(() => {
            progress.style.setProperty('--shipping-progress', `${targetProgress}%`);
          });
        });
      };

      const renderGlobalCartDrawer = async () => {
        if (!globalCartDrawerBody) return;
        globalCartDrawerBody.innerHTML = '<p class="product-info-drawer__cart-empty">Winkelwagen laden...</p>';
        try {
          const cartState = await getGlobalCartState();
          globalCartDrawerBody.innerHTML = buildGlobalCartContent(cartState);
          animateGlobalShippingProgress();
        } catch (error) {
          console.error(error);
          globalCartDrawerBody.innerHTML = '<p class="product-info-drawer__cart-empty">De winkelwagen kon niet worden geladen.</p>';
        }
      };

      const renderGlobalWishlistDrawer = async () => {
        if (!globalWishlistDrawerBody) return;
        globalWishlistDrawerBody.innerHTML = '<p class="product-info-drawer__wishlist-empty">Verlanglijstje laden...</p>';
        try {
          const response = await fetch(document.body?.dataset?.wishlistEndpoint || '/apps/wishlist/proxy', {
            credentials: 'same-origin',
            headers: {
              Accept: 'application/json',
            },
          });

          if (response.status === 401) {
            globalWishlistDrawerBody.innerHTML = '<p class="product-info-drawer__wishlist-empty">Log in om je verlanglijstje te bekijken.</p>';
            return;
          }

          if (!response.ok) throw new Error('Wishlist fetch failed');

          const payload = await response.json();
          if (payload?.authenticated === false) {
            globalWishlistDrawerBody.innerHTML = '<p class="product-info-drawer__wishlist-empty">Log in om je verlanglijstje te bekijken.</p>';
            return;
          }

          globalWishlistDrawerBody.innerHTML = buildGlobalWishlistContent(payload);
        } catch (error) {
          console.error(error);
          globalWishlistDrawerBody.innerHTML = '<p class="product-info-drawer__wishlist-empty">Het verlanglijstje kon niet worden geladen.</p>';
        }
      };

      const addWishlistDrawerItemToCart = async (button) => {
        if (!button) return;

        const purchaseRow = button.closest('.product-info-drawer__wishlist-purchase');
        const selectedSize =
          purchaseRow?.querySelector('.account-wishlist__size-summary-label')?.textContent?.trim() || '';

        if (!selectedSize || selectedSize === 'Maat selecteren') return;

        const productUrl = button.dataset.productUrl;
        if (!productUrl) return;

        button.disabled = true;

        try {
          const productResponse = await fetch(`${productUrl}.js`, {
            credentials: 'same-origin',
            headers: {
              Accept: 'application/json',
            },
          });

          if (!productResponse.ok) throw new Error('Wishlist product fetch failed');

          const productData = await productResponse.json();
          const matchingVariant = (productData.variants || []).find((variant) => {
            return [variant.option1, variant.option2, variant.option3].some((option) => option === selectedSize);
          });

          if (!matchingVariant?.id) throw new Error('No matching variant found');

          const cartResponse = await fetch(`${window.routes?.cart_add_url || '/cart/add'}.js`, {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json',
            },
            body: JSON.stringify({
              items: [
                {
                  id: matchingVariant.id,
                  quantity: 1,
                },
              ],
            }),
          });

          if (!cartResponse.ok) throw new Error('Wishlist add to cart failed');

          await cartResponse.json();
          updateGlobalCartIcon();
          openGlobalCartDrawer();
        } catch (error) {
          console.error(error);
        } finally {
          button.disabled = false;
        }
      };

      const closeGlobalCartDrawer = () => {
        if (!globalCartDrawer) return;
        globalCartDrawer.classList.remove('is-open');
        globalCartDrawer.setAttribute('aria-hidden', 'true');
        document.documentElement.classList.remove('product-info-drawer-open');
      };

      const closeGlobalWishlistDrawer = () => {
        if (!globalWishlistDrawer) return;
        globalWishlistDrawer.classList.remove('is-open');
        globalWishlistDrawer.setAttribute('aria-hidden', 'true');
        document.documentElement.classList.remove('product-info-drawer-open');
      };

      const openGlobalCartDrawer = () => {
        if (!globalCartDrawer) return false;
        closeGlobalWishlistDrawer();
        globalCartDrawer.classList.add('is-open');
        globalCartDrawer.setAttribute('aria-hidden', 'false');
        document.documentElement.classList.add('product-info-drawer-open');
        renderGlobalCartDrawer();
        return true;
      };

      const openGlobalWishlistDrawer = () => {
        if (!globalWishlistDrawer) return false;
        closeGlobalCartDrawer();
        globalWishlistDrawer.classList.add('is-open');
        globalWishlistDrawer.setAttribute('aria-hidden', 'false');
        document.documentElement.classList.add('product-info-drawer-open');
        renderGlobalWishlistDrawer();
        return true;
      };

      const switchGlobalMobileDrawer = (fromDrawer, toDrawer, renderCallback) => {
        if (!fromDrawer || !toDrawer) return false;
        fromDrawer.classList.add('is-switching');
        toDrawer.classList.add('is-switching');
        fromDrawer.classList.remove('is-open');
        fromDrawer.setAttribute('aria-hidden', 'true');
        toDrawer.classList.add('is-open');
        toDrawer.setAttribute('aria-hidden', 'false');
        document.documentElement.classList.add('product-info-drawer-open');
        renderCallback?.();
        window.requestAnimationFrame(() => {
          fromDrawer.classList.remove('is-switching');
          toDrawer.classList.remove('is-switching');
        });
        return true;
      };

      globalCartDrawerCloseButtons.forEach((button) => {
        button.addEventListener('click', closeGlobalCartDrawer);
      });

      globalWishlistDrawerCloseButtons.forEach((button) => {
        button.addEventListener('click', closeGlobalWishlistDrawer);
      });

      document.addEventListener('click', (event) => {
        const wishlistLink = event.target.closest('[data-mobile-cart-wishlist-link]');
        if (wishlistLink && window.matchMedia('(max-width: 749px)').matches) {
          event.preventDefault();
          switchGlobalMobileDrawer(globalCartDrawer, globalWishlistDrawer, renderGlobalWishlistDrawer);
          return;
        }

        const wishlistToCart = event.target.closest('[data-mobile-wishlist-open-cart]');
        if (wishlistToCart && window.matchMedia('(max-width: 749px)').matches) {
          event.preventDefault();
          switchGlobalMobileDrawer(globalWishlistDrawer, globalCartDrawer, renderGlobalCartDrawer);
          return;
        }

        const headerWishlistLink = event.target.closest('.header__icon--wishlist');
        if (headerWishlistLink && window.matchMedia('(max-width: 749px)').matches) {
          event.preventDefault();
          openGlobalWishlistDrawer();
          return;
        }

        const wishlistCartButton = event.target.closest('[data-mobile-wishlist-cart]');
        if (wishlistCartButton && window.matchMedia('(max-width: 749px)').matches) {
          event.preventDefault();
          addWishlistDrawerItemToCart(wishlistCartButton);
        }
      });

      globalCartDrawer?.addEventListener(
        'wheel',
        (event) => {
          if (!window.matchMedia('(min-width: 1024px) and (max-width: 1440px)').matches) return;
          const scrollArea = event.target.closest('.product-info-drawer__cart-scroll');
          if (!scrollArea) return;
          event.preventDefault();
          scrollArea.scrollTop += event.deltaY * 0.58;
        },
        { passive: false }
      );

      globalCartDrawerBody?.addEventListener('click', async (event) => {
        const quantityButton = event.target.closest('[data-global-cart-quantity-action]');
        if (!quantityButton) return;

        const quantityWrapper = quantityButton.closest('[data-global-cart-line-key]');
        const itemKey = quantityWrapper?.dataset.globalCartLineKey;
        const currentQuantity = Number(quantityWrapper?.dataset.globalCartLineQuantity || 1);
        const quantityAction = quantityButton.dataset.globalCartQuantityAction;
        const nextQuantity = quantityAction === 'plus' ? currentQuantity + 1 : Math.max(currentQuantity - 1, 0);

        if (!itemKey) return;

        quantityButton.disabled = true;
        try {
          const response = await fetch(`${window.routes?.cart_change_url || '/cart/change'}.js`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json',
            },
            body: JSON.stringify({ id: itemKey, quantity: nextQuantity }),
          });
          if (!response.ok) throw new Error('Cart quantity update failed');
          const cartState = await response.json();
          globalCartDrawerBody.innerHTML = buildGlobalCartContent(cartState);
          animateGlobalShippingProgress();
          updateGlobalCartIcon();
        } catch (error) {
          console.error(error);
        } finally {
          quantityButton.disabled = false;
        }
      });

        document.addEventListener('keyup', (event) => {
        if (event.code === 'Escape') {
          closeGlobalCartDrawer();
          closeGlobalWishlistDrawer();
        }
      });

      const openWogCartDrawer = (trigger) => {
        const productCartRequest = new CustomEvent('wog:open-product-cart-drawer', { cancelable: true });
        document.dispatchEvent(productCartRequest);
        if (productCartRequest.defaultPrevented) {
          return true;
        }

        if (openGlobalCartDrawer()) {
          return true;
        }

        const cartNotification = document.querySelector('cart-notification');
        if (cartNotification && typeof cartNotification.open === 'function') {
          cartNotification.open();
          return true;
        }

        const cartDrawer = document.querySelector('cart-drawer');
        if (cartDrawer && typeof cartDrawer.open === 'function') {
          cartDrawer.open(trigger || document.querySelector('#cart-icon-bubble'));
          return true;
        }

        return false;
      };

      document.addEventListener('wog:wishlist-cart-added', async (event) => {
        await updateGlobalCartIcon();
        openWogCartDrawer(event.detail?.trigger || document.querySelector('#cart-icon-bubble'));
        if (typeof event.detail?.onComplete === 'function') {
          event.detail.onComplete();
        }
      });

      document.addEventListener(
        'click',
        (event) => {
          const cartLink = event.target.closest('#cart-icon-bubble');
          if (!cartLink) return;
          event.preventDefault();
          event.stopImmediatePropagation();
          openWogCartDrawer(cartLink);
        },
        true
      );

      document.addEventListener('DOMContentLoaded', () => {
        const params = new URLSearchParams(window.location.search);
        if (params.get('open-cart') !== '1') return;
        openWogCartDrawer();
        params.delete('open-cart');
        const nextSearch = params.toString();
        window.history.replaceState({}, '', `${window.location.pathname}${nextSearch ? `?${nextSearch}` : ''}${window.location.hash}`);
      });
    </script>
    <script src="{{ 'wishlist.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
